new file mode 100644
index 0000000..435b685
--- /dev/null
+++ b/dlls/winusb.sys/winusb.c
@@ -0,0 +1,840 @@
+/*
+ * WinUSB function driver
+ *
+ * Copyright 2026 ciroprogamer
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * This driver sits on top of a USB device PDO created by wineusb.sys (one
+ * per device, or one per interface of a composite device). It registers the
+ * device interface classes listed in the "DeviceInterfaceGUIDs" device
+ * parameter, exactly like the native WinUSB does, so that applications can
+ * find the device with SetupDiGetClassDevs() and open it. winusb.dll then
+ * talks to it with the private ioctls defined in wine/winusb_ioctl.h, which
+ * are translated here into URBs for wineusb.sys.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winioctl.h"
+#include "winternl.h"
+#include "ddk/wdm.h"
+#include "ddk/usb.h"
+#include "ddk/usbioctl.h"
+#include "winusbio.h"
+#include "wine/debug.h"
+#include "wine/winusb_ioctl.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winusb);
+
+/* Data is transferred in chunks of this size, to stay well below the usbfs
+ * per-process memory limit (16 MiB by default). */
+#define MAX_CHUNK_SIZE (1024 * 1024)
+
+#define MAX_PIPES 64
+#define MAX_DEVICE_INTERFACES 8
+
+struct pipe
+{
+    UCHAR address;
+    UCHAR type;
+    USHORT max_packet;
+    USBD_PIPE_HANDLE handle;
+};
+
+struct device
+{
+    DEVICE_OBJECT *device, *pdo, *lower;
+
+    BOOL started, removed;
+
+    UNICODE_STRING iface_names[MAX_DEVICE_INTERFACES];
+    unsigned int iface_count;
+
+    UCHAR device_desc[sizeof(USB_DEVICE_DESCRIPTOR)];
+    UCHAR *config;
+    USHORT config_len;
+    UCHAR speed;
+
+    UCHAR interfaces[WINE_WINUSB_MAX_INTERFACES];
+    UCHAR interface_count;
+
+    struct pipe pipes[MAX_PIPES];
+    unsigned int pipe_count;
+};
+
+static const char *debugstr_setup(const UCHAR *setup)
+{
+    return wine_dbg_sprintf("{%02x %02x %04x %04x %04x}", setup[0], setup[1],
+            setup[2] | (setup[3] << 8), setup[4] | (setup[5] << 8), setup[6] | (setup[7] << 8));
+}
+
+static NTSTATUS status_from_urb(NTSTATUS irp_status, USBD_STATUS urb_status)
+{
+    if (irp_status && irp_status != STATUS_PENDING)
+        return irp_status;
+    if (USBD_SUCCESS(urb_status))
+        return STATUS_SUCCESS;
+
+    switch (urb_status)
+    {
+        case USBD_STATUS_CANCELED:      return STATUS_CANCELLED;
+        case USBD_STATUS_DEVICE_GONE:   return STATUS_DEVICE_NOT_CONNECTED;
+        case USBD_STATUS_TIMEOUT:       return STATUS_IO_TIMEOUT;
+        default:                        return STATUS_UNSUCCESSFUL;
+    }
+}
+
+static struct pipe *find_pipe(struct device *device, UCHAR address)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->pipe_count; ++i)
+    {
+        if (device->pipes[i].address == address)
+            return &device->pipes[i];
+    }
+    return NULL;
+}
+
+/* Synchronous I/O to the lower device; must not be called from the wineusb
+ * event thread. */
+
+static NTSTATUS WINAPI sync_completion(DEVICE_OBJECT *device, IRP *irp, void *context)
+{
+    if (irp->PendingReturned)
+        KeSetEvent(context, IO_NO_INCREMENT, FALSE);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+static NTSTATUS submit_urb_sync(struct device *device, URB *urb)
+{
+    IO_STACK_LOCATION *stack;
+    NTSTATUS status;
+    KEVENT event;
+    IRP *irp;
+
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+
+    if (!(irp = IoAllocateIrp(device->lower->StackSize, FALSE)))
+        return STATUS_NO_MEMORY;
+
+    stack = IoGetNextIrpStackLocation(irp);
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = urb;
+    IoSetCompletionRoutine(irp, sync_completion, &event, TRUE, TRUE, TRUE);
+
+    if (IoCallDriver(device->lower, irp) == STATUS_PENDING)
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+
+    status = status_from_urb(irp->IoStatus.Status, urb->UrbHeader.Status);
+    IoFreeIrp(irp);
+    return status;
+}
+
+static NTSTATUS get_descriptor_sync(struct device *device, UCHAR type, UCHAR index,
+        void *buffer, ULONG length, ULONG *ret_length)
+{
+    struct _URB_CONTROL_DESCRIPTOR_REQUEST urb = {{0}};
+    NTSTATUS status;
+
+    urb.Hdr.Length = sizeof(urb);
+    urb.Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = length;
+    urb.DescriptorType = type;
+    urb.Index = index;
+
+    status = submit_urb_sync(device, (URB *)&urb);
+    if (ret_length) *ret_length = urb.TransferBufferLength;
+    return status;
+}
+
+static BOOL interface_is_ours(struct device *device, UCHAR number)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->interface_count; ++i)
+    {
+        if (device->interfaces[i] == number)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* wineusb.sys creates one PDO per interface for composite devices, with a
+ * hardware ID ending in "&MI_xx". Returns -1 for a whole device. */
+static int get_pdo_interface(struct device *device)
+{
+    WCHAR buffer[512], *p;
+    ULONG needed;
+
+    if (IoGetDeviceProperty(device->pdo, DevicePropertyHardwareID, sizeof(buffer) - sizeof(WCHAR),
+            buffer, &needed))
+        return -1;
+    buffer[ARRAY_SIZE(buffer) - 1] = 0;
+
+    TRACE("hardware ID %s.\n", debugstr_w(buffer));
+
+    if (!(p = wcsstr(buffer, L"&MI_")))
+        return -1;
+    return wcstoul(p + 4, NULL, 16);
+}
+
+static void parse_config(struct device *device)
+{
+    const UCHAR *ptr = device->config, *end = device->config + device->config_len;
+    int pdo_interface = get_pdo_interface(device);
+    BOOL ours = FALSE;
+
+    device->interface_count = 0;
+    device->pipe_count = 0;
+
+    /* Collect the interfaces we expose, in descriptor order. */
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == USB_INTERFACE_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            const USB_INTERFACE_DESCRIPTOR *iface = (const USB_INTERFACE_DESCRIPTOR *)ptr;
+
+            if ((pdo_interface == -1 || iface->bInterfaceNumber == pdo_interface)
+                    && !interface_is_ours(device, iface->bInterfaceNumber)
+                    && device->interface_count < WINE_WINUSB_MAX_INTERFACES)
+                device->interfaces[device->interface_count++] = iface->bInterfaceNumber;
+        }
+        ptr += ptr[0];
+    }
+
+    /* Collect the endpoints of those interfaces, including all alternate
+     * settings. */
+    ptr = device->config;
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == USB_INTERFACE_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            const USB_INTERFACE_DESCRIPTOR *iface = (const USB_INTERFACE_DESCRIPTOR *)ptr;
+            ours = interface_is_ours(device, iface->bInterfaceNumber);
+        }
+        else if (ptr[1] == USB_ENDPOINT_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_ENDPOINT_DESCRIPTOR) && ours)
+        {
+            const USB_ENDPOINT_DESCRIPTOR *ep = (const USB_ENDPOINT_DESCRIPTOR *)ptr;
+
+            if (!find_pipe(device, ep->bEndpointAddress) && device->pipe_count < MAX_PIPES)
+            {
+                struct pipe *pipe = &device->pipes[device->pipe_count++];
+
+                pipe->address = ep->bEndpointAddress;
+                pipe->type = ep->bmAttributes & USB_ENDPOINT_TYPE_MASK;
+                pipe->max_packet = ep->wMaxPacketSize & 0x7ff;
+                pipe->handle = NULL;
+                TRACE("endpoint %#x, type %u, max packet %u.\n", pipe->address, pipe->type, pipe->max_packet);
+            }
+        }
+        ptr += ptr[0];
+    }
+
+    TRACE("PDO interface %d, exposing %u interfaces and %u pipes.\n",
+            pdo_interface, device->interface_count, device->pipe_count);
+}
+
+static NTSTATUS select_configuration(struct device *device)
+{
+    struct _URB_SELECT_CONFIGURATION *urb;
+    unsigned int i, size;
+    NTSTATUS status;
+
+    if (!device->pipe_count)
+        return STATUS_SUCCESS;
+
+    size = FIELD_OFFSET(struct _URB_SELECT_CONFIGURATION, Interface.Pipes[device->pipe_count]);
+    if (!(urb = ExAllocatePool(NonPagedPool, size)))
+        return STATUS_NO_MEMORY;
+    memset(urb, 0, size);
+
+    urb->Hdr.Length = size;
+    urb->Hdr.Function = URB_FUNCTION_SELECT_CONFIGURATION;
+    urb->ConfigurationDescriptor = (USB_CONFIGURATION_DESCRIPTOR *)device->config;
+    urb->Interface.Length = size - FIELD_OFFSET(struct _URB_SELECT_CONFIGURATION, Interface);
+    urb->Interface.InterfaceNumber = device->interfaces[0];
+    urb->Interface.NumberOfPipes = device->pipe_count;
+    for (i = 0; i < device->pipe_count; ++i)
+    {
+        USBD_PIPE_INFORMATION *pipe = &urb->Interface.Pipes[i];
+
+        pipe->EndpointAddress = device->pipes[i].address;
+        pipe->PipeType = device->pipes[i].type;
+        pipe->MaximumPacketSize = device->pipes[i].max_packet;
+        pipe->MaximumTransferSize = MAX_CHUNK_SIZE;
+    }
+
+    if (!(status = submit_urb_sync(device, (URB *)urb)))
+    {
+        for (i = 0; i < device->pipe_count; ++i)
+            device->pipes[i].handle = urb->Interface.Pipes[i].PipeHandle;
+    }
+
+    ExFreePool(urb);
+    return status;
+}
+
+static NTSTATUS init_usb_device(struct device *device)
+{
+    USB_CONFIGURATION_DESCRIPTOR header;
+    const USB_DEVICE_DESCRIPTOR *desc;
+    ULONG len;
+    NTSTATUS status;
+
+    if ((status = get_descriptor_sync(device, USB_DEVICE_DESCRIPTOR_TYPE, 0,
+            device->device_desc, sizeof(device->device_desc), &len)))
+    {
+        ERR("Failed to get device descriptor, status %#lx.\n", status);
+        return status;
+    }
+    desc = (const USB_DEVICE_DESCRIPTOR *)device->device_desc;
+    TRACE("device %04x:%04x, bcdUSB %04x.\n", desc->idVendor, desc->idProduct, desc->bcdUSB);
+
+    /* WinUSB reports HighSpeed for anything faster than full speed. */
+    device->speed = desc->bcdUSB >= 0x0200 ? HighSpeed : FullSpeed;
+
+    if ((status = get_descriptor_sync(device, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0,
+            &header, sizeof(header), &len)) || len < sizeof(header))
+    {
+        ERR("Failed to get configuration descriptor header, status %#lx.\n", status);
+        return status ? status : STATUS_UNSUCCESSFUL;
+    }
+
+    if (!(device->config = ExAllocatePool(NonPagedPool, header.wTotalLength)))
+        return STATUS_NO_MEMORY;
+    if ((status = get_descriptor_sync(device, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0,
+            device->config, header.wTotalLength, &len)))
+    {
+        ERR("Failed to get configuration descriptor, status %#lx.\n", status);
+        return status;
+    }
+    device->config_len = len;
+
+    parse_config(device);
+
+    if ((status = select_configuration(device)))
+        ERR("Failed to select configuration, status %#lx.\n", status);
+    return status;
+}
+
+static void register_device_interfaces(struct device *device)
+{
+    static const WCHAR *const value_names[] = {L"DeviceInterfaceGUIDs", L"DeviceInterfaceGUID"};
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    UNICODE_STRING name, guid_str;
+    ULONG size = 4096, ret_size;
+    unsigned int i;
+    NTSTATUS status;
+    HANDLE key;
+    GUID guid;
+    WCHAR *p;
+
+    if ((status = IoOpenDeviceRegistryKey(device->pdo, PLUGPLAY_REGKEY_DEVICE, KEY_READ, &key)))
+    {
+        ERR("Failed to open device registry key, status %#lx.\n", status);
+        return;
+    }
+
+    if (!(info = ExAllocatePool(PagedPool, size)))
+    {
+        ZwClose(key);
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(value_names) && !device->iface_count; ++i)
+    {
+        RtlInitUnicodeString(&name, value_names[i]);
+        memset(info, 0, size);
+        if (ZwQueryValueKey(key, &name, KeyValuePartialInformation, info, size - sizeof(WCHAR), &ret_size))
+            continue;
+        if (info->Type != REG_SZ && info->Type != REG_MULTI_SZ && info->Type != REG_EXPAND_SZ)
+            continue;
+
+        for (p = (WCHAR *)info->Data; *p && device->iface_count < MAX_DEVICE_INTERFACES; p += wcslen(p) + 1)
+        {
+            RtlInitUnicodeString(&guid_str, p);
+            if (RtlGUIDFromString(&guid_str, &guid))
+            {
+                WARN("Invalid interface GUID %s.\n", debugstr_w(p));
+                continue;
+            }
+
+            if ((status = IoRegisterDeviceInterface(device->pdo, &guid, NULL,
+                    &device->iface_names[device->iface_count])))
+            {
+                ERR("Failed to register interface %s, status %#lx.\n", debugstr_guid(&guid), status);
+                continue;
+            }
+            TRACE("Registered interface %s as %s.\n", debugstr_guid(&guid),
+                    debugstr_w(device->iface_names[device->iface_count].Buffer));
+            ++device->iface_count;
+        }
+    }
+
+    if (!device->iface_count)
+        WARN("No DeviceInterfaceGUIDs found; the device can't be opened by applications.\n");
+
+    ExFreePool(info);
+    ZwClose(key);
+}
+
+static void set_interfaces_state(struct device *device, BOOL enable)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->iface_count; ++i)
+        IoSetDeviceInterfaceState(&device->iface_names[i], enable);
+}
+
+static NTSTATUS forward_irp_sync(struct device *device, IRP *irp)
+{
+    KEVENT event;
+    NTSTATUS status;
+
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+    IoCopyCurrentIrpStackLocationToNext(irp);
+    IoSetCompletionRoutine(irp, sync_completion, &event, TRUE, TRUE, TRUE);
+
+    status = IoCallDriver(device->lower, irp);
+    if (status == STATUS_PENDING)
+    {
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+        status = irp->IoStatus.Status;
+    }
+    return status;
+}
+
+static NTSTATUS WINAPI driver_pnp(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct device *device = device_obj->DeviceExtension;
+    NTSTATUS status;
+    unsigned int i;
+
+    TRACE("device %p, irp %p, minor function %#x.\n", device_obj, irp, stack->MinorFunction);
+
+    switch (stack->MinorFunction)
+    {
+        case IRP_MN_START_DEVICE:
+            if ((status = forward_irp_sync(device, irp)))
+            {
+                irp->IoStatus.Status = status;
+                IoCompleteRequest(irp, IO_NO_INCREMENT);
+                return status;
+            }
+
+            if (!(status = init_usb_device(device)))
+            {
+                if (!device->iface_count)
+                    register_device_interfaces(device);
+                device->started = TRUE;
+                set_interfaces_state(device, TRUE);
+            }
+
+            irp->IoStatus.Status = status;
+            IoCompleteRequest(irp, IO_NO_INCREMENT);
+            return status;
+
+        case IRP_MN_SURPRISE_REMOVAL:
+            device->removed = TRUE;
+            set_interfaces_state(device, FALSE);
+            irp->IoStatus.Status = STATUS_SUCCESS;
+            IoSkipCurrentIrpStackLocation(irp);
+            return IoCallDriver(device->lower, irp);
+
+        case IRP_MN_REMOVE_DEVICE:
+            device->removed = TRUE;
+            set_interfaces_state(device, FALSE);
+
+            irp->IoStatus.Status = STATUS_SUCCESS;
+            IoSkipCurrentIrpStackLocation(irp);
+            status = IoCallDriver(device->lower, irp);
+
+            for (i = 0; i < device->iface_count; ++i)
+                RtlFreeUnicodeString(&device->iface_names[i]);
+            if (device->config)
+                ExFreePool(device->config);
+            IoDetachDevice(device->lower);
+            IoDeleteDevice(device->device);
+            return status;
+
+        default:
+            IoSkipCurrentIrpStackLocation(irp);
+            return IoCallDriver(device->lower, irp);
+    }
+}
+
+static NTSTATUS complete_request(IRP *irp, NTSTATUS status, ULONG_PTR information)
+{
+    irp->IoStatus.Status = status;
+    irp->IoStatus.Information = information;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return status;
+}
+
+static NTSTATUS WINAPI driver_create_close(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct device *device = device_obj->DeviceExtension;
+
+    TRACE("device %p, irp %p, major %#x.\n", device_obj, irp, stack->MajorFunction);
+
+    if (stack->MajorFunction == IRP_MJ_CREATE && (device->removed || !device->started))
+        return complete_request(irp, STATUS_DELETE_PENDING, 0);
+    return complete_request(irp, STATUS_SUCCESS, 0);
+}
+
+/* Asynchronous transfers. The user IRP itself is sent down to wineusb.sys,
+ * one chunk at a time; the completion routine resubmits it until the
+ * transfer is done. Cancellation is handled by wineusb.sys. */
+
+struct transfer
+{
+    union
+    {
+        struct _URB_HEADER hdr;
+        struct _URB_BULK_OR_INTERRUPT_TRANSFER bulk;
+        struct _URB_CONTROL_TRANSFER control;
+        struct _URB_PIPE_REQUEST pipe;
+    } urb;
+
+    struct device *device;
+    UCHAR *buffer;
+    ULONG total, done, chunk;
+    USBD_PIPE_HANDLE pipe;
+    USHORT max_packet;
+    BOOL in, zlp, zlp_phase, is_control;
+};
+
+static NTSTATUS WINAPI transfer_completion(DEVICE_OBJECT *device_obj, IRP *irp, void *context);
+
+static void prepare_lower(struct transfer *transfer, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetNextIrpStackLocation(irp);
+
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->MinorFunction = 0;
+    stack->Flags = 0;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = &transfer->urb;
+    IoSetCompletionRoutine(irp, transfer_completion, transfer, TRUE, TRUE, TRUE);
+}
+
+static void submit_bulk_chunk(struct transfer *transfer, IRP *irp)
+{
+    struct _URB_BULK_OR_INTERRUPT_TRANSFER *req = &transfer->urb.bulk;
+    ULONG len = transfer->zlp_phase ? 0 : min(transfer->total - transfer->done, MAX_CHUNK_SIZE);
+
+    memset(req, 0, sizeof(*req));
+    req->Hdr.Length = sizeof(*req);
+    req->Hdr.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+    req->PipeHandle = transfer->pipe;
+    req->TransferFlags = transfer->in ? (USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK) : 0;
+    req->TransferBufferLength = len;
+    req->TransferBuffer = transfer->buffer + transfer->done;
+    transfer->chunk = len;
+
+    prepare_lower(transfer, irp);
+    IoCallDriver(transfer->device->lower, irp);
+}
+
+static NTSTATUS WINAPI transfer_completion(DEVICE_OBJECT *device_obj, IRP *irp, void *context)
+{
+    struct transfer *transfer = context;
+    NTSTATUS status;
+    ULONG got;
+
+    status = status_from_urb(irp->IoStatus.Status, transfer->urb.hdr.Status);
+
+    if (transfer->is_control)
+    {
+        got = transfer->urb.control.TransferBufferLength;
+        TRACE("control transfer done, status %#lx, length %lu.\n", status, got);
+        ExFreePool(transfer);
+        complete_request(irp, status, NT_ERROR(status) ? 0 : got);
+        return STATUS_MORE_PROCESSING_REQUIRED;
+    }
+
+    got = transfer->urb.bulk.TransferBufferLength;
+    if (!transfer->zlp_phase && got <= transfer->chunk)
+        transfer->done += got;
+
+    TRACE("pipe %p chunk done, status %#lx, got %lu/%lu, total %lu/%lu.\n", transfer->pipe,
+            status, got, transfer->chunk, transfer->done, transfer->total);
+
+    if (!status && !transfer->zlp_phase)
+    {
+        BOOL more = transfer->done < transfer->total && got == transfer->chunk;
+
+        if (!more && transfer->zlp && !transfer->in && transfer->total
+                && transfer->max_packet && !(transfer->total % transfer->max_packet))
+        {
+            transfer->zlp_phase = TRUE;
+            more = TRUE;
+        }
+
+        if (more)
+        {
+            if (irp->Cancel)
+            {
+                status = STATUS_CANCELLED;
+            }
+            else
+            {
+                submit_bulk_chunk(transfer, irp);
+                return STATUS_MORE_PROCESSING_REQUIRED;
+            }
+        }
+    }
+
+    if (status == STATUS_CANCELLED && transfer->in && transfer->done)
+    {
+        /* WinUSB reports the data received before the cancellation. */
+        status = STATUS_SUCCESS;
+    }
+
+    /* For writes there is no output buffer; Information still reaches the
+     * caller as the number of bytes transferred. */
+    got = transfer->done;
+    ExFreePool(transfer);
+    complete_request(irp, status, got);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+static NTSTATUS start_bulk(struct device *device, IRP *irp, BOOL in)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG in_len = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    struct wine_winusb_transfer header;
+    struct transfer *transfer;
+    struct pipe *pipe;
+
+    if (in_len < sizeof(header))
+        return complete_request(irp, STATUS_INVALID_PARAMETER, 0);
+    memcpy(&header, irp->AssociatedIrp.SystemBuffer, sizeof(header));
+
+    if (!(pipe = find_pipe(device, header.pipe)) || !pipe->handle
+            || !!(header.pipe & USB_ENDPOINT_DIRECTION_MASK) != in
+            || (pipe->type != UsbdPipeTypeBulk && pipe->type != UsbdPipeTypeInterrupt))
+    {
+        WARN("Invalid pipe %#x for %s.\n", header.pipe, in ? "read" : "write");
+        return complete_request(irp, STATUS_INVALID_PARAMETER, 0);
+    }
+
+    if (in ? header.length > out_len : header.length > in_len - sizeof(header))
+        return complete_request(irp, STATUS_INVALID_PARAMETER, 0);
+
+    if (!(transfer = ExAllocatePool(NonPagedPool, sizeof(*transfer))))
+        return complete_request(irp, STATUS_NO_MEMORY, 0);
+    memset(transfer, 0, sizeof(*transfer));
+
+    transfer->device = device;
+    transfer->in = in;
+    transfer->pipe = pipe->handle;
+    transfer->max_packet = pipe->max_packet;
+    transfer->total = header.length;
+    transfer->zlp = !!(header.flags & WINE_WINUSB_FLAG_ZLP);
+    /* for writes, the data follows the header in the input buffer; reads
+     * are returned at the start of the (shared) system buffer */
+    transfer->buffer = (UCHAR *)irp->AssociatedIrp.SystemBuffer + (in ? 0 : sizeof(header));
+
+    TRACE("%s pipe %#x, length %lu.\n", in ? "read" : "write", header.pipe, (ULONG)header.length);
+
+    IoMarkIrpPending(irp);
+    submit_bulk_chunk(transfer, irp);
+    return STATUS_PENDING;
+}
+
+static NTSTATUS start_control(struct device *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG in_len = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    struct _URB_CONTROL_TRANSFER *req;
+    struct wine_winusb_control header;
+    struct transfer *transfer;
+    USHORT length;
+    BOOL in;
+
+    if (in_len < sizeof(header))
+        return complete_request(irp, STATUS_INVALID_PARAMETER, 0);
+    memcpy(&header, irp->AssociatedIrp.SystemBuffer, sizeof(header));
+
+    in = !!(header.setup[0] & 0x80);
+    length = header.setup[6] | (header.setup[7] << 8);
+
+    TRACE("setup %s.\n", debugstr_setup(header.setup));
+
+    if (in ? length > out_len : length > in_len - sizeof(header))
+        return complete_request(irp, STATUS_INVALID_PARAMETER, 0);
+
+    if (!(transfer = ExAllocatePool(NonPagedPool, sizeof(*transfer))))
+        return complete_request(irp, STATUS_NO_MEMORY, 0);
+    memset(transfer, 0, sizeof(*transfer));
+    transfer->device = device;
+    transfer->is_control = TRUE;
+    transfer->in = in;
+
+    req = &transfer->urb.control;
+    req->Hdr.Length = sizeof(*req);
+    req->Hdr.Function = URB_FUNCTION_CONTROL_TRANSFER;
+    req->TransferFlags = (in ? USBD_TRANSFER_DIRECTION_IN : 0) | USBD_SHORT_TRANSFER_OK;
+    req->TransferBufferLength = length;
+    /* IN data goes at the start of the system buffer, OUT data follows the header */
+    req->TransferBuffer = (UCHAR *)irp->AssociatedIrp.SystemBuffer + (in ? 0 : sizeof(header));
+    memcpy(req->SetupPacket, header.setup, sizeof(req->SetupPacket));
+
+    IoMarkIrpPending(irp);
+    prepare_lower(transfer, irp);
+    IoCallDriver(device->lower, irp);
+    return STATUS_PENDING;
+}
+
+static NTSTATUS pipe_request(struct device *device, IRP *irp, USHORT function)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct _URB_PIPE_REQUEST urb = {{0}};
+    struct wine_winusb_pipe header;
+    struct pipe *pipe;
+    NTSTATUS status;
+
+    if (stack->Parameters.DeviceIoControl.InputBufferLength < sizeof(header))
+        return complete_request(irp, STATUS_INVALID_PARAMETER, 0);
+    memcpy(&header, irp->AssociatedIrp.SystemBuffer, sizeof(header));
+
+    if (!(pipe = find_pipe(device, header.pipe)) || !pipe->handle)
+        return complete_request(irp, STATUS_INVALID_PARAMETER, 0);
+
+    TRACE("function %#x, pipe %#x.\n", function, header.pipe);
+
+    urb.Hdr.Length = sizeof(urb);
+    urb.Hdr.Function = function;
+    urb.PipeHandle = pipe->handle;
+
+    /* Both requests complete synchronously in wineusb.sys. */
+    status = submit_urb_sync(device, (URB *)&urb);
+    return complete_request(irp, status, 0);
+}
+
+static NTSTATUS get_info(struct device *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    struct wine_winusb_info *info = irp->AssociatedIrp.SystemBuffer;
+    ULONG size = sizeof(*info) + device->config_len;
+
+    if (out_len < size)
+        return complete_request(irp, STATUS_BUFFER_TOO_SMALL, 0);
+
+    memset(info, 0, sizeof(*info));
+    info->size = size;
+    info->speed = device->speed;
+    info->interface_count = device->interface_count;
+    info->config_length = device->config_len;
+    memcpy(info->interfaces, device->interfaces, device->interface_count);
+    memcpy(info->device_descriptor, device->device_desc, sizeof(info->device_descriptor));
+    memcpy(info + 1, device->config, device->config_len);
+
+    return complete_request(irp, STATUS_SUCCESS, size);
+}
+
+static NTSTATUS WINAPI driver_ioctl(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    struct device *device = device_obj->DeviceExtension;
+
+    TRACE("device %p, irp %p, code %#lx.\n", device_obj, irp, code);
+
+    if (device->removed)
+        return complete_request(irp, STATUS_DEVICE_NOT_CONNECTED, 0);
+    if (!device->started)
+        return complete_request(irp, STATUS_DEVICE_NOT_READY, 0);
+
+    switch (code)
+    {
+        case IOCTL_WINE_WINUSB_GET_INFO:
+            return get_info(device, irp);
+        case IOCTL_WINE_WINUSB_CONTROL:
+            return start_control(device, irp);
+        case IOCTL_WINE_WINUSB_READ_PIPE:
+            return start_bulk(device, irp, TRUE);
+        case IOCTL_WINE_WINUSB_WRITE_PIPE:
+            return start_bulk(device, irp, FALSE);
+        case IOCTL_WINE_WINUSB_ABORT_PIPE:
+            return pipe_request(device, irp, URB_FUNCTION_ABORT_PIPE);
+        case IOCTL_WINE_WINUSB_RESET_PIPE:
+            return pipe_request(device, irp, URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL);
+        default:
+            FIXME("Unhandled ioctl %#lx.\n", code);
+            return complete_request(irp, STATUS_NOT_SUPPORTED, 0);
+    }
+}
+
+static NTSTATUS WINAPI driver_add_device(DRIVER_OBJECT *driver, DEVICE_OBJECT *pdo)
+{
+    struct device *device;
+    DEVICE_OBJECT *fdo;
+    NTSTATUS status;
+
+    TRACE("driver %p, pdo %p.\n", driver, pdo);
+
+    if ((status = IoCreateDevice(driver, sizeof(*device), NULL, FILE_DEVICE_USB, 0, FALSE, &fdo)))
+    {
+        ERR("Failed to create FDO, status %#lx.\n", status);
+        return status;
+    }
+
+    device = fdo->DeviceExtension;
+    memset(device, 0, sizeof(*device));
+    device->device = fdo;
+    device->pdo = pdo;
+    device->lower = IoAttachDeviceToDeviceStack(fdo, pdo);
+
+    fdo->Flags |= DO_BUFFERED_IO;
+    fdo->Flags &= ~DO_DEVICE_INITIALIZING;
+    return STATUS_SUCCESS;
+}
+
+static void WINAPI driver_unload(DRIVER_OBJECT *driver)
+{
+    TRACE("driver %p.\n", driver);
+}
+
+NTSTATUS WINAPI DriverEntry(DRIVER_OBJECT *driver, UNICODE_STRING *path)
+{
+    TRACE("driver %p, path %s.\n", driver, debugstr_w(path->Buffer));
+
+    driver->DriverExtension->AddDevice = driver_add_device;
+    driver->DriverUnload = driver_unload;
+    driver->MajorFunction[IRP_MJ_PNP] = driver_pnp;
+    driver->MajorFunction[IRP_MJ_CREATE] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_CLOSE] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_CLEANUP] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_DEVICE_CONTROL] = driver_ioctl;
+
+    return STATUS_SUCCESS;
+}
