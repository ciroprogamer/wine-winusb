+/*
+ * This driver sits on top of a USB device PDO created by wineusb.sys (one
+ * per device, or one per interface of a composite device). It registers the
+ * device interface classes listed in the "DeviceInterfaceGUIDs" device
+ * parameter, exactly like the native WinUSB does, so that applications can
+ * find the device with SetupDiGetClassDevs() and open it. winusb.dll then
+ * talks to it with the private ioctls defined in wine/winusb_ioctl.h, which
+ * are translated here into URBs for wineusb.sys.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winioctl.h"
+#include "winternl.h"
+#include "ddk/wdm.h"
+#include "ddk/usb.h"
+#include "ddk/usbioctl.h"
+#include "winusbio.h"
+#include "wine/debug.h"
+#include "wine/winusb_ioctl.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(winusb);
+
+/* Data is transferred in chunks of this size, to stay well below the usbfs
+ * per-process memory limit (16 MiB by default). */
+#define MAX_CHUNK_SIZE (1024 * 1024)
+
+#define MAX_PIPES 64
+#define MAX_DEVICE_INTERFACES 8
+
+struct pipe
+{
+    UCHAR address;
+    UCHAR type;
+    USHORT max_packet;
+    USBD_PIPE_HANDLE handle;
+
+    /* Unless RAW_IO is set, the reads of a pipe are processed one at a time,
+     * like the native WinUSB does. That keeps the data in order when a read
+     * takes several requests to the device, or leaves the rest of a packet
+     * behind for the next read. */
+    KSPIN_LOCK lock;        /* protects the fields below */
+    LIST_ENTRY read_queue;  /* reads waiting for the active one to finish */
+    BOOL reading;           /* a read is active */
+    BOOL pumping, repump;   /* see read_finished() */
+    ULONG abort_count;      /* number of times the pipe was aborted */
+    UCHAR *stash;           /* data received past the end of a read */
+    ULONG stash_len, stash_pos;
+    BOOL stash_short;       /* that data ended with a short packet */
+};
+
+struct device
+{
+    DEVICE_OBJECT *device, *pdo, *lower;
+
+    BOOL started, removed;
+    LONG io_count;          /* requests that are being processed */
+
+    UNICODE_STRING iface_names[MAX_DEVICE_INTERFACES];
+    unsigned int iface_count;
+
+    UCHAR device_desc[sizeof(USB_DEVICE_DESCRIPTOR)];
+    UCHAR *config;
+    USHORT config_len;
+    UCHAR speed;
+
+    UCHAR interfaces[WINE_WINUSB_MAX_INTERFACES];
+    UCHAR interface_count;
+
+    struct pipe pipes[MAX_PIPES];
+    unsigned int pipe_count;
+};
+
+static const char *debugstr_setup(const UCHAR *setup)
+{
+    return wine_dbg_sprintf("{%02x %02x %04x %04x %04x}", setup[0], setup[1],
+            setup[2] | (setup[3] << 8), setup[4] | (setup[5] << 8), setup[6] | (setup[7] << 8));
+}
+
+static NTSTATUS status_from_urb(NTSTATUS irp_status, USBD_STATUS urb_status)
+{
+    /* the lower driver is being removed */
+    if (irp_status == STATUS_DELETE_PENDING)
+        return STATUS_DEVICE_NOT_CONNECTED;
+    if (irp_status && irp_status != STATUS_PENDING)
+        return irp_status;
+    if (USBD_SUCCESS(urb_status))
+        return STATUS_SUCCESS;
+
+    switch (urb_status)
+    {
+        case USBD_STATUS_CANCELED:      return STATUS_CANCELLED;
+        case USBD_STATUS_DEVICE_GONE:   return STATUS_DEVICE_NOT_CONNECTED;
+        case USBD_STATUS_TIMEOUT:       return STATUS_IO_TIMEOUT;
+        default:                        return STATUS_UNSUCCESSFUL;
+    }
+}
+
+static struct pipe *find_pipe(struct device *device, UCHAR address)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->pipe_count; ++i)
+    {
+        if (device->pipes[i].address == address)
+            return &device->pipes[i];
+    }
+    return NULL;
+}
+
+/* Synchronous I/O to the lower device. Must not be called from the wineusb
+ * event thread, unless the request is one that wineusb.sys completes right
+ * away. */
+
+static NTSTATUS WINAPI sync_completion(DEVICE_OBJECT *device, IRP *irp, void *context)
+{
+    if (irp->PendingReturned)
+        KeSetEvent(context, IO_NO_INCREMENT, FALSE);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+static NTSTATUS internal_ioctl_sync(struct device *device, ULONG code, void *arg)
+{
+    IO_STACK_LOCATION *stack;
+    NTSTATUS status;
+    KEVENT event;
+    IRP *irp;
+
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+
+    if (!(irp = IoAllocateIrp(device->lower->StackSize, FALSE)))
+        return STATUS_NO_MEMORY;
+
+    stack = IoGetNextIrpStackLocation(irp);
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = code;
+    stack->Parameters.Others.Argument1 = arg;
+    IoSetCompletionRoutine(irp, sync_completion, &event, TRUE, TRUE, TRUE);
+
+    if (IoCallDriver(device->lower, irp) == STATUS_PENDING)
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+
+    status = irp->IoStatus.Status;
+    IoFreeIrp(irp);
+    return status;
+}
+
+static NTSTATUS submit_urb_sync(struct device *device, struct _URB_HEADER *urb)
+{
+    NTSTATUS status = internal_ioctl_sync(device, IOCTL_INTERNAL_USB_SUBMIT_URB, urb);
+
+    return status_from_urb(status, urb->Status);
+}
+
+static NTSTATUS get_descriptor_sync(struct device *device, UCHAR type, UCHAR index,
+        void *buffer, ULONG length, ULONG *ret_length)
+{
+    struct _URB_CONTROL_DESCRIPTOR_REQUEST urb = {{0}};
+    NTSTATUS status;
+
+    urb.Hdr.Length = sizeof(urb);
+    urb.Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+    urb.TransferBuffer = buffer;
+    urb.TransferBufferLength = length;
+    urb.DescriptorType = type;
+    urb.Index = index;
+
+    status = submit_urb_sync(device, &urb.Hdr);
+    if (ret_length) *ret_length = urb.TransferBufferLength;
+    return status;
+}
+
+/* Completes synchronously in wineusb.sys. */
+static NTSTATUS pipe_request_sync(struct device *device, USHORT function, USBD_PIPE_HANDLE handle)
+{
+    struct _URB_PIPE_REQUEST urb = {{0}};
+
+    urb.Hdr.Length = sizeof(urb);
+    urb.Hdr.Function = function;
+    urb.PipeHandle = handle;
+    return submit_urb_sync(device, &urb.Hdr);
+}
+
+static BOOL interface_is_ours(struct device *device, UCHAR number)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->interface_count; ++i)
+    {
+        if (device->interfaces[i] == number)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* wineusb.sys creates one PDO per interface for composite devices, with a
+ * hardware ID ending in "&MI_xx". Returns -1 for a whole device. */
+static int get_pdo_interface(struct device *device)
+{
+    WCHAR buffer[512], *p;
+    ULONG needed;
+
+    if (IoGetDeviceProperty(device->pdo, DevicePropertyHardwareID, sizeof(buffer) - sizeof(WCHAR),
+            buffer, &needed))
+        return -1;
+    buffer[ARRAY_SIZE(buffer) - 1] = 0;
+
+    TRACE("hardware ID %s.\n", debugstr_w(buffer));
+
+    if (!(p = wcsstr(buffer, L"&MI_")))
+        return -1;
+    return wcstoul(p + 4, NULL, 16);
+}
+
+static void free_stashed_data(struct device *device)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->pipe_count; ++i)
+    {
+        if (device->pipes[i].stash)
+            ExFreePool(device->pipes[i].stash);
+        device->pipes[i].stash = NULL;
+    }
+}
+
+static void parse_config(struct device *device)
+{
+    const UCHAR *ptr = device->config, *end = device->config + device->config_len;
+    int pdo_interface = get_pdo_interface(device);
+    BOOL ours = FALSE;
+
+    free_stashed_data(device);
+    device->interface_count = 0;
+    device->pipe_count = 0;
+
+    /* Collect the interfaces we expose, in descriptor order. */
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == USB_INTERFACE_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            const USB_INTERFACE_DESCRIPTOR *iface = (const USB_INTERFACE_DESCRIPTOR *)ptr;
+
+            if ((pdo_interface == -1 || iface->bInterfaceNumber == pdo_interface)
+                    && !interface_is_ours(device, iface->bInterfaceNumber)
+                    && device->interface_count < WINE_WINUSB_MAX_INTERFACES)
+                device->interfaces[device->interface_count++] = iface->bInterfaceNumber;
+        }
+        ptr += ptr[0];
+    }
+
+    /* Collect the endpoints of those interfaces, including all alternate
+     * settings. */
+    ptr = device->config;
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == USB_INTERFACE_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            const USB_INTERFACE_DESCRIPTOR *iface = (const USB_INTERFACE_DESCRIPTOR *)ptr;
+            ours = interface_is_ours(device, iface->bInterfaceNumber);
+        }
+        else if (ptr[1] == USB_ENDPOINT_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_ENDPOINT_DESCRIPTOR) && ours)
+        {
+            const USB_ENDPOINT_DESCRIPTOR *ep = (const USB_ENDPOINT_DESCRIPTOR *)ptr;
+
+            if (!find_pipe(device, ep->bEndpointAddress) && device->pipe_count < MAX_PIPES)
+            {
+                struct pipe *pipe = &device->pipes[device->pipe_count++];
+
+                memset(pipe, 0, sizeof(*pipe));
+                pipe->address = ep->bEndpointAddress;
+                pipe->type = ep->bmAttributes & USB_ENDPOINT_TYPE_MASK;
+                pipe->max_packet = ep->wMaxPacketSize & 0x7ff;
+                KeInitializeSpinLock(&pipe->lock);
+                InitializeListHead(&pipe->read_queue);
+                TRACE("endpoint %#x, type %u, max packet %u.\n", pipe->address, pipe->type, pipe->max_packet);
+            }
+        }
+        ptr += ptr[0];
+    }
+
+    TRACE("PDO interface %d, exposing %u interfaces and %u pipes.\n",
+            pdo_interface, device->interface_count, device->pipe_count);
+}
+
+static NTSTATUS select_configuration(struct device *device)
+{
+    struct _URB_SELECT_CONFIGURATION *urb;
+    unsigned int i, size;
+    NTSTATUS status;
+
+    if (!device->pipe_count)
+        return STATUS_SUCCESS;
+
+    size = FIELD_OFFSET(struct _URB_SELECT_CONFIGURATION, Interface.Pipes[device->pipe_count]);
+    if (!(urb = ExAllocatePool(NonPagedPool, size)))
+        return STATUS_NO_MEMORY;
+    memset(urb, 0, size);
+
+    urb->Hdr.Length = size;
+    urb->Hdr.Function = URB_FUNCTION_SELECT_CONFIGURATION;
+    urb->ConfigurationDescriptor = (USB_CONFIGURATION_DESCRIPTOR *)device->config;
+    urb->Interface.Length = size - FIELD_OFFSET(struct _URB_SELECT_CONFIGURATION, Interface);
+    urb->Interface.InterfaceNumber = device->interfaces[0];
+    urb->Interface.NumberOfPipes = device->pipe_count;
+    for (i = 0; i < device->pipe_count; ++i)
+    {
+        USBD_PIPE_INFORMATION *pipe = &urb->Interface.Pipes[i];
+
+        pipe->EndpointAddress = device->pipes[i].address;
+        pipe->PipeType = device->pipes[i].type;
+        pipe->MaximumPacketSize = device->pipes[i].max_packet;
+        pipe->MaximumTransferSize = MAX_CHUNK_SIZE;
+    }
+
+    if (!(status = submit_urb_sync(device, &urb->Hdr)))
+    {
+        for (i = 0; i < device->pipe_count; ++i)
+            device->pipes[i].handle = urb->Interface.Pipes[i].PipeHandle;
+    }
+
+    ExFreePool(urb);
+    return status;
+}
+
+/* The speed the device is actually running at. bcdUSB only says which
+ * version of the specification the device follows; plenty of full speed
+ * devices report 2.00. */
+static UCHAR get_device_speed(struct device *device)
+{
+    const USB_DEVICE_DESCRIPTOR *desc = (const USB_DEVICE_DESCRIPTOR *)device->device_desc;
+    UCHAR speed = 0;
+
+    if (!internal_ioctl_sync(device, IOCTL_INTERNAL_WINE_USB_GET_SPEED, &speed) && speed)
+    {
+        TRACE("bus speed %u.\n", speed);
+        /* WinUSB reports HighSpeed for anything faster than full speed. */
+        return min(speed, HighSpeed);
+    }
+
+    WARN("The bus driver doesn't know the speed, guessing from bcdUSB %04x.\n", desc->bcdUSB);
+    return desc->bcdUSB >= 0x0200 ? HighSpeed : FullSpeed;
+}
+
+static NTSTATUS init_usb_device(struct device *device)
+{
+    USB_CONFIGURATION_DESCRIPTOR header;
+    const USB_DEVICE_DESCRIPTOR *desc;
+    ULONG len;
+    NTSTATUS status;
+
+    if ((status = get_descriptor_sync(device, USB_DEVICE_DESCRIPTOR_TYPE, 0,
+            device->device_desc, sizeof(device->device_desc), &len)))
+    {
+        ERR("Failed to get device descriptor, status %#lx.\n", status);
+        return status;
+    }
+    desc = (const USB_DEVICE_DESCRIPTOR *)device->device_desc;
+    TRACE("device %04x:%04x, bcdUSB %04x.\n", desc->idVendor, desc->idProduct, desc->bcdUSB);
+
+    device->speed = get_device_speed(device);
+
+    if ((status = get_descriptor_sync(device, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0,
+            &header, sizeof(header), &len)) || len < sizeof(header))
+    {
+        ERR("Failed to get configuration descriptor header, status %#lx.\n", status);
+        return status ? status : STATUS_UNSUCCESSFUL;
+    }
+
+    if (device->config)
+        ExFreePool(device->config);
+    if (!(device->config = ExAllocatePool(NonPagedPool, header.wTotalLength)))
+        return STATUS_NO_MEMORY;
+    if ((status = get_descriptor_sync(device, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0,
+            device->config, header.wTotalLength, &len)))
+    {
+        ERR("Failed to get configuration descriptor, status %#lx.\n", status);
+        return status;
+    }
+    device->config_len = len;
+
+    parse_config(device);
+
+    if ((status = select_configuration(device)))
+        ERR("Failed to select configuration, status %#lx.\n", status);
+    return status;
+}
+
+static void register_device_interfaces(struct device *device)
+{
+    static const WCHAR *const value_names[] = {L"DeviceInterfaceGUIDs", L"DeviceInterfaceGUID"};
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    UNICODE_STRING name, guid_str;
+    ULONG size = 4096, ret_size;
+    unsigned int i;
+    NTSTATUS status;
+    HANDLE key;
+    GUID guid;
+    WCHAR *p;
+
+    if ((status = IoOpenDeviceRegistryKey(device->pdo, PLUGPLAY_REGKEY_DEVICE, KEY_READ, &key)))
+    {
+        ERR("Failed to open device registry key, status %#lx.\n", status);
+        return;
+    }
+
+    if (!(info = ExAllocatePool(PagedPool, size)))
+    {
+        ZwClose(key);
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(value_names) && !device->iface_count; ++i)
+    {
+        RtlInitUnicodeString(&name, value_names[i]);
+        memset(info, 0, size);
+        if (ZwQueryValueKey(key, &name, KeyValuePartialInformation, info, size - sizeof(WCHAR), &ret_size))
+            continue;
+        if (info->Type != REG_SZ && info->Type != REG_MULTI_SZ && info->Type != REG_EXPAND_SZ)
+            continue;
+
+        for (p = (WCHAR *)info->Data; *p && device->iface_count < MAX_DEVICE_INTERFACES; p += wcslen(p) + 1)
+        {
+            RtlInitUnicodeString(&guid_str, p);
+            if (RtlGUIDFromString(&guid_str, &guid))
+            {
+                WARN("Invalid interface GUID %s.\n", debugstr_w(p));
+                continue;
+            }
+
+            if ((status = IoRegisterDeviceInterface(device->pdo, &guid, NULL,
+                    &device->iface_names[device->iface_count])))
+            {
+                ERR("Failed to register interface %s, status %#lx.\n", debugstr_guid(&guid), status);
+                continue;
+            }
+            TRACE("Registered interface %s as %s.\n", debugstr_guid(&guid),
+                    debugstr_w(device->iface_names[device->iface_count].Buffer));
+            ++device->iface_count;
+        }
+    }
+
+    if (!device->iface_count)
+        WARN("No DeviceInterfaceGUIDs found; the device can't be opened by applications.\n");
+
+    ExFreePool(info);
+    ZwClose(key);
+}
+
+static void set_interfaces_state(struct device *device, BOOL enable)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->iface_count; ++i)
+        IoSetDeviceInterfaceState(&device->iface_names[i], enable);
+}
+
+static NTSTATUS forward_irp_sync(struct device *device, IRP *irp)
+{
+    KEVENT event;
+    NTSTATUS status;
+
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+    IoCopyCurrentIrpStackLocationToNext(irp);
+    IoSetCompletionRoutine(irp, sync_completion, &event, TRUE, TRUE, TRUE);
+
+    status = IoCallDriver(device->lower, irp);
+    if (status == STATUS_PENDING)
+    {
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+        status = irp->IoStatus.Status;
+    }
+    return status;
+}
+
+static NTSTATUS complete_request(IRP *irp, NTSTATUS status, ULONG_PTR information)
+{
+    irp->IoStatus.Status = status;
+    irp->IoStatus.Information = information;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return status;
+}
+
+/* Every ioctl counts as I/O in progress from driver_ioctl() until the
+ * driver is done with it, which is later than the completion of its IRP
+ * if another read of the pipe is started from there. The device object is
+ * not deleted before that. */
+static void io_leave(struct device *device)
+{
+    InterlockedDecrement(&device->io_count);
+}
+
+static NTSTATUS complete_ioctl(struct device *device, IRP *irp, NTSTATUS status, ULONG_PTR information)
+{
+    complete_request(irp, status, information);
+    io_leave(device);
+    return status;
+}
+
+/* Transfers. The user IRP itself is sent down to wineusb.sys, one request
+ * at a time; the completion routine sends it again until the transfer is
+ * done. wineusb.sys takes care of cancelling the IRP while it has it. */
+
+enum transfer_type
+{
+    TRANSFER_CONTROL,
+    TRANSFER_WRITE,
+    TRANSFER_READ,
+};
+
+struct transfer
+{
+    union
+    {
+        struct _URB_HEADER hdr;
+        struct _URB_BULK_OR_INTERRUPT_TRANSFER bulk;
+        struct _URB_CONTROL_TRANSFER control;
+    } urb;
+
+    struct device *device;
+    struct pipe *pipe;      /* NULL for control transfers */
+    IRP *irp;
+    enum transfer_type type;
+    UCHAR flags;            /* WINE_WINUSB_FLAG_* */
+    BOOL queued;            /* a read that goes through the pipe's read queue */
+
+    UCHAR *buffer;          /* the caller's data */
+    ULONG total, done;
+    ULONG chunk;            /* part of the current request that is for the caller */
+    ULONG requested;        /* size of the current request to the device */
+    UCHAR *bounce;          /* its buffer, if that is not the caller's */
+    BOOL zlp_phase;
+    ULONG abort_count;      /* pipe->abort_count when the transfer started */
+
+    ULONG timeout;          /* in ms */
+    BOOL timer_set, timed_out;
+    KTIMER timer;
+    KDPC dpc;
+};
+
+static NTSTATUS WINAPI transfer_completion(DEVICE_OBJECT *device_obj, IRP *irp, void *context);
+static void start_read(struct transfer *transfer);
+
+/* PIPE_TRANSFER_TIMEOUT: the IRP is cancelled when the time is up, and the
+ * resulting status is turned into a timeout. */
+static void WINAPI transfer_timeout(KDPC *dpc, void *context, void *arg1, void *arg2)
+{
+    struct transfer *transfer = context;
+
+    TRACE("irp %p timed out.\n", transfer->irp);
+
+    transfer->timed_out = TRUE;
+    IoCancelIrp(transfer->irp);
+}
+
+static void start_timer(struct transfer *transfer)
+{
+    LARGE_INTEGER due;
+
+    if (!transfer->timeout) return;
+
+    KeInitializeTimer(&transfer->timer);
+    KeInitializeDpc(&transfer->dpc, transfer_timeout, transfer);
+    transfer->timer_set = TRUE;
+    due.QuadPart = (LONGLONG)transfer->timeout * -10000;
+    KeSetTimer(&transfer->timer, due, &transfer->dpc);
+}
+
+/* Returns the next read of the queue that has not been cancelled. The pipe
+ * lock must be held. */
+static struct transfer *pop_queued_read(struct pipe *pipe)
+{
+    while (!IsListEmpty(&pipe->read_queue))
+    {
+        LIST_ENTRY *entry = RemoveHeadList(&pipe->read_queue);
+        IRP *irp = CONTAINING_RECORD(entry, IRP, Tail.Overlay.ListEntry);
+
+        if (IoSetCancelRoutine(irp, NULL))
+            return irp->Tail.Overlay.DriverContext[1];
+
+        /* cancel_queued_read() is about to run, and to unlink the IRP */
+        InitializeListHead(entry);
+    }
+    return NULL;
+}
+
+/* The active read of a pipe is done; start the one that waited the longest. */
+static void read_finished(struct pipe *pipe)
+{
+    struct transfer *next;
+    KIRQL irql;
+
+    KeAcquireSpinLock(&pipe->lock, &irql);
+    if (pipe->pumping)
+    {
+        /* The loop below is running, in this thread (it started a read
+         * that finished at once) or in another one (which has not noticed
+         * yet that the read it started is pending). Let it carry on, so
+         * that a long queue doesn't turn into a deep recursion. */
+        pipe->repump = TRUE;
+        KeReleaseSpinLock(&pipe->lock, irql);
+        return;
+    }
+
+    for (;;)
+    {
+        if (!(next = pop_queued_read(pipe)))
+        {
+            pipe->reading = FALSE;
+            break;
+        }
+        pipe->pumping = TRUE;
+        pipe->repump = FALSE;
+        KeReleaseSpinLock(&pipe->lock, irql);
+
+        start_read(next);
+
+        KeAcquireSpinLock(&pipe->lock, &irql);
+        pipe->pumping = FALSE;
+        if (!pipe->repump) break; /* the read is pending */
+    }
+    KeReleaseSpinLock(&pipe->lock, irql);
+}
+
+static void finish_transfer(struct transfer *transfer, NTSTATUS status)
+{
+    struct device *device = transfer->device;
+    struct pipe *pipe = transfer->pipe;
+    BOOL queued = transfer->queued;
+    IRP *irp = transfer->irp;
+    ULONG_PTR information;
+
+    /* This waits for transfer_timeout() if it is running. */
+    if (transfer->timer_set)
+        KeCancelTimer(&transfer->timer);
+
+    if (status == STATUS_CANCELLED && transfer->timed_out)
+        status = STATUS_IO_TIMEOUT;
+
+    if ((status == STATUS_CANCELLED || status == STATUS_IO_TIMEOUT)
+            && transfer->type == TRANSFER_READ && transfer->done)
+    {
+        /* Report the data received until then; an error status would
+         * discard it. */
+        status = STATUS_SUCCESS;
+    }
+
+    if (pipe && (transfer->flags & WINE_WINUSB_FLAG_AUTO_CLEAR_STALL)
+            && (transfer->urb.hdr.Status == USBD_STATUS_ENDPOINT_HALTED
+            || transfer->urb.hdr.Status == USBD_STATUS_STALL_PID))
+    {
+        TRACE("clearing the stall of pipe %#x.\n", pipe->address);
+        pipe_request_sync(device, URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL, pipe->handle);
+    }
+
+    TRACE("irp %p done, status %#lx, %lu/%lu bytes.\n", irp, status, transfer->done, transfer->total);
+
+    /* For writes there is no output buffer; Information still reaches the
+     * caller as the number of bytes transferred. */
+    information = transfer->done;
+    if (transfer->type == TRANSFER_CONTROL && NT_ERROR(status))
+        information = 0;
+
+    if (transfer->bounce)
+        ExFreePool(transfer->bounce);
+    ExFreePool(transfer);
+    complete_request(irp, status, information);
+
+    if (queued)
+        read_finished(pipe);
+    io_leave(device);
+}
+
+/* Reasons not to send another request for a transfer to the device. */
+static NTSTATUS transfer_stop_status(struct transfer *transfer)
+{
+    if (transfer->device->removed)
+        return STATUS_DEVICE_NOT_CONNECTED;
+    if (transfer->irp->Cancel)
+        return STATUS_CANCELLED;
+    if (transfer->pipe && transfer->pipe->abort_count != transfer->abort_count)
+        return STATUS_CANCELLED; /* aborted between two requests */
+    return STATUS_SUCCESS;
+}
+
+static void call_lower(struct transfer *transfer)
+{
+    IO_STACK_LOCATION *stack = IoGetNextIrpStackLocation(transfer->irp);
+
+    /* Tells a URB that never reached the device from one that did. */
+    transfer->urb.hdr.Status = USBD_STATUS_PENDING;
+
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->MinorFunction = 0;
+    stack->Flags = 0;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = &transfer->urb;
+    IoSetCompletionRoutine(transfer->irp, transfer_completion, transfer, TRUE, TRUE, TRUE);
+    IoCallDriver(transfer->device->lower, transfer->irp);
+}
+
+static void submit_bulk(struct transfer *transfer, void *buffer, ULONG length)
+{
+    struct _URB_BULK_OR_INTERRUPT_TRANSFER *req = &transfer->urb.bulk;
+    BOOL in = transfer->type == TRANSFER_READ;
+
+    memset(req, 0, sizeof(*req));
+    req->Hdr.Length = sizeof(*req);
+    req->Hdr.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+    req->PipeHandle = transfer->pipe->handle;
+    req->TransferFlags = in ? (USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK) : 0;
+    req->TransferBufferLength = length;
+    req->TransferBuffer = buffer;
+    transfer->requested = length;
+
+    call_lower(transfer);
+}
+
+/* Largest request that is a multiple of the packet size. */
+static ULONG max_chunk_size(const struct pipe *pipe)
+{
+    if (!pipe->max_packet) return MAX_CHUNK_SIZE;
+    return MAX_CHUNK_SIZE - MAX_CHUNK_SIZE % pipe->max_packet;
+}
+
+static void continue_write(struct transfer *transfer)
+{
+    NTSTATUS status;
+
+    if ((status = transfer_stop_status(transfer)))
+    {
+        finish_transfer(transfer, status);
+        return;
+    }
+
+    transfer->chunk = transfer->zlp_phase ? 0 : min(transfer->total - transfer->done, max_chunk_size(transfer->pipe));
+    submit_bulk(transfer, transfer->buffer + transfer->done, transfer->chunk);
+}
+
+static void write_completed(struct transfer *transfer, NTSTATUS status, ULONG got)
+{
+    const struct pipe *pipe = transfer->pipe;
+
+    if (!transfer->zlp_phase)
+        transfer->done += got;
+
+    if (!status && !transfer->zlp_phase)
+    {
+        BOOL more = transfer->done < transfer->total && got == transfer->chunk;
+
+        if (!more && (transfer->flags & WINE_WINUSB_FLAG_ZLP) && transfer->total
+                && transfer->done == transfer->total
+                && pipe->max_packet && !(transfer->total % pipe->max_packet))
+        {
+            transfer->zlp_phase = TRUE;
+            more = TRUE;
+        }
+
+        if (more)
+        {
+            continue_write(transfer);
+            return;
+        }
+    }
+
+    finish_transfer(transfer, status);
+}
+
+/* Takes the data that an earlier read left behind. Returns TRUE if the
+ * device had ended its transfer with that data. */
+static BOOL take_stashed_data(struct transfer *transfer)
+{
+    struct pipe *pipe = transfer->pipe;
+    BOOL short_packet = FALSE;
+    UCHAR *stash = NULL;
+    KIRQL irql;
+    ULONG len;
+
+    KeAcquireSpinLock(&pipe->lock, &irql);
+    if (pipe->stash)
+    {
+        len = min(pipe->stash_len - pipe->stash_pos, transfer->total - transfer->done);
+        memcpy(transfer->buffer + transfer->done, pipe->stash + pipe->stash_pos, len);
+        transfer->done += len;
+        pipe->stash_pos += len;
+        if (pipe->stash_pos == pipe->stash_len)
+        {
+            short_packet = pipe->stash_short;
+            stash = pipe->stash;
+            pipe->stash = NULL;
+        }
+    }
+    KeReleaseSpinLock(&pipe->lock, irql);
+
+    if (stash)
+        ExFreePool(stash);
+    return short_packet;
+}
+
+static void discard_stashed_data(struct pipe *pipe)
+{
+    UCHAR *stash;
+    KIRQL irql;
+
+    KeAcquireSpinLock(&pipe->lock, &irql);
+    stash = pipe->stash;
+    pipe->stash = NULL;
+    KeReleaseSpinLock(&pipe->lock, irql);
+
+    if (stash)
+        ExFreePool(stash);
+}
+
+static void continue_read(struct transfer *transfer)
+{
+    const struct pipe *pipe = transfer->pipe;
+    ULONG need = transfer->total - transfer->done;
+    NTSTATUS status;
+
+    if (!need)
+    {
+        finish_transfer(transfer, STATUS_SUCCESS);
+        return;
+    }
+    if ((status = transfer_stop_status(transfer)))
+    {
+        finish_transfer(transfer, status);
+        return;
+    }
+
+    /* The device sends whole packets, and a request that ends in the
+     * middle of one fails with an overflow. So only whole packets are
+     * requested; if the caller wants less, the last packet is received in
+     * a buffer of our own, and what the caller didn't ask for is kept for
+     * the next read. With RAW_IO, the caller takes care of that. */
+    if ((transfer->flags & WINE_WINUSB_FLAG_RAW_IO) || !pipe->max_packet || need >= pipe->max_packet)
+    {
+        transfer->chunk = min(need, max_chunk_size(pipe));
+        if (pipe->max_packet && !(transfer->flags & WINE_WINUSB_FLAG_RAW_IO))
+            transfer->chunk -= transfer->chunk % pipe->max_packet;
+        submit_bulk(transfer, transfer->buffer + transfer->done, transfer->chunk);
+        return;
+    }
+
+    if (!(transfer->bounce = ExAllocatePool(NonPagedPool, pipe->max_packet)))
+    {
+        finish_transfer(transfer, STATUS_NO_MEMORY);
+        return;
+    }
+    transfer->chunk = need;
+    submit_bulk(transfer, transfer->bounce, pipe->max_packet);
+}
+
+static void read_completed(struct transfer *transfer, NTSTATUS status, ULONG got)
+{
+    struct pipe *pipe = transfer->pipe;
+    BOOL short_packet = got < transfer->requested;
+    ULONG extra = 0;
+    KIRQL irql;
+
+    if (transfer->bounce)
+    {
+        ULONG copy = min(got, transfer->chunk);
+
+        memcpy(transfer->buffer + transfer->done, transfer->bounce, copy);
+        extra = got - copy;
+        got = copy;
+    }
+    transfer->done += got;
+
+    TRACE("pipe %#x request done, status %#lx, got %lu/%lu (+%lu), total %lu/%lu.\n", pipe->address,
+            status, got, transfer->chunk, extra, transfer->done, transfer->total);
+
+    if (extra && !status)
+    {
+        if (!(transfer->flags & WINE_WINUSB_FLAG_ALLOW_PARTIAL))
+        {
+            WARN("The device sent %lu bytes more than requested.\n", extra);
+            status = STATUS_DATA_OVERRUN;
+        }
+        else if (!(transfer->flags & WINE_WINUSB_FLAG_AUTO_FLUSH))
+        {
+            /* the next read starts with this */
+            KeAcquireSpinLock(&pipe->lock, &irql);
+            if (pipe->stash)
+                ExFreePool(pipe->stash);
+            pipe->stash = transfer->bounce;
+            pipe->stash_pos = got;
+            pipe->stash_len = got + extra;
+            pipe->stash_short = short_packet;
+            KeReleaseSpinLock(&pipe->lock, irql);
+            transfer->bounce = NULL;
+        }
+    }
+    if (transfer->bounce)
+    {
+        ExFreePool(transfer->bounce);
+        transfer->bounce = NULL;
+    }
+
+    if (status || (short_packet && !(transfer->flags & WINE_WINUSB_FLAG_IGNORE_SHORT)))
+        finish_transfer(transfer, status);
+    else
+        continue_read(transfer);
+}
+
+/* The read is now the active one of its pipe, or bypasses the queue. */
+static void start_read(struct transfer *transfer)
+{
+    TRACE("irp %p, pipe %#x, length %lu.\n", transfer->irp, transfer->pipe->address, transfer->total);
+
+    transfer->abort_count = transfer->pipe->abort_count;
+    start_timer(transfer);
+
+    if (transfer->queued && take_stashed_data(transfer)
+            && !(transfer->flags & WINE_WINUSB_FLAG_IGNORE_SHORT))
+    {
+        /* the device had finished its transfer */
+        finish_transfer(transfer, STATUS_SUCCESS);
+        return;
+    }
+    continue_read(transfer);
+}
+
+/* A read that waits for its turn is cancelled. */
+static void WINAPI cancel_queued_read(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    struct transfer *transfer = irp->Tail.Overlay.DriverContext[1];
+    struct device *device = transfer->device;
+    KIRQL irql;
+
+    TRACE("irp %p.\n", irp);
+
+    IoReleaseCancelSpinLock(irp->CancelIrql);
+
+    /* It is either still queued, or pop_queued_read() made the entry
+     * point to itself. */
+    KeAcquireSpinLock(&transfer->pipe->lock, &irql);
+    RemoveEntryList(&irp->Tail.Overlay.ListEntry);
+    KeReleaseSpinLock(&transfer->pipe->lock, irql);
+
+    ExFreePool(transfer);
+    complete_ioctl(device, irp, STATUS_CANCELLED, 0);
+}
+
+static void queue_read(struct transfer *transfer)
+{
+    struct pipe *pipe = transfer->pipe;
+    IRP *irp = transfer->irp;
+    KIRQL irql;
+
+    KeAcquireSpinLock(&pipe->lock, &irql);
+    if (!pipe->reading)
+    {
+        pipe->reading = TRUE;
+        KeReleaseSpinLock(&pipe->lock, irql);
+        start_read(transfer);
+        return;
+    }
+
+    irp->Tail.Overlay.DriverContext[1] = transfer;
+    InsertTailList(&pipe->read_queue, &irp->Tail.Overlay.ListEntry);
+    IoSetCancelRoutine(irp, cancel_queued_read);
+    if (irp->Cancel && IoSetCancelRoutine(irp, NULL))
+    {
+        struct device *device = transfer->device;
+
+        /* cancelled before the cancel routine was set */
+        RemoveEntryList(&irp->Tail.Overlay.ListEntry);
+        KeReleaseSpinLock(&pipe->lock, irql);
+        ExFreePool(transfer);
+        complete_ioctl(device, irp, STATUS_CANCELLED, 0);
+        return;
+    }
+    KeReleaseSpinLock(&pipe->lock, irql);
+}
+
+/* Completes the reads that wait in the queue of a pipe, and makes its
+ * active transfers stop before their next request. */
+static void abort_queued_reads(struct device *device, struct pipe *pipe, NTSTATUS status)
+{
+    struct transfer *transfer;
+    LIST_ENTRY aborted;
+    KIRQL irql;
+
+    InitializeListHead(&aborted);
+
+    KeAcquireSpinLock(&pipe->lock, &irql);
+    ++pipe->abort_count;
+    while ((transfer = pop_queued_read(pipe)))
+        InsertTailList(&aborted, &transfer->irp->Tail.Overlay.ListEntry);
+    KeReleaseSpinLock(&pipe->lock, irql);
+
+    while (!IsListEmpty(&aborted))
+    {
+        IRP *irp = CONTAINING_RECORD(RemoveHeadList(&aborted), IRP, Tail.Overlay.ListEntry);
+
+        ExFreePool(irp->Tail.Overlay.DriverContext[1]);
+        complete_ioctl(device, irp, status, 0);
+    }
+}
+
+static NTSTATUS WINAPI transfer_completion(DEVICE_OBJECT *device_obj, IRP *irp, void *context)
+{
+    struct transfer *transfer = context;
+    NTSTATUS status;
+    ULONG got = 0;
+
+    status = status_from_urb(irp->IoStatus.Status, transfer->urb.hdr.Status);
+
+    /* If the request failed before it got to the device, the URB still
+     * has the length that was asked for. */
+    if (transfer->urb.hdr.Status != USBD_STATUS_PENDING)
+    {
+        if (transfer->type == TRANSFER_CONTROL)
+            got = transfer->urb.control.TransferBufferLength;
+        else
+            got = transfer->urb.bulk.TransferBufferLength;
+        got = min(got, transfer->requested);
+    }
+
+    switch (transfer->type)
+    {
+        case TRANSFER_CONTROL:
+            transfer->done = got;
+            finish_transfer(transfer, status);
+            break;
+
+        case TRANSFER_WRITE:
+            write_completed(transfer, status, got);
+            break;
+
+        case TRANSFER_READ:
+            read_completed(transfer, status, got);
+            break;
+    }
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+static NTSTATUS start_bulk(struct device *device, IRP *irp, BOOL in)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG in_len = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    struct wine_winusb_transfer header;
+    struct transfer *transfer;
+    struct pipe *pipe;
+
+    if (in_len < sizeof(header))
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+    memcpy(&header, irp->AssociatedIrp.SystemBuffer, sizeof(header));
+
+    if (!(pipe = find_pipe(device, header.pipe)) || !pipe->handle
+            || !!(header.pipe & USB_ENDPOINT_DIRECTION_MASK) != in
+            || (pipe->type != UsbdPipeTypeBulk && pipe->type != UsbdPipeTypeInterrupt))
+    {
+        WARN("Invalid pipe %#x for %s.\n", header.pipe, in ? "read" : "write");
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+    }
+
+    if (in ? header.length > out_len : header.length > in_len - sizeof(header))
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+
+    if (in && (header.flags & WINE_WINUSB_FLAG_RAW_IO) && pipe->max_packet
+            && header.length % pipe->max_packet)
+    {
+        WARN("RAW_IO read of %u bytes is not a multiple of the packet size %u.\n",
+                (unsigned int)header.length, pipe->max_packet);
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+    }
+
+    /* A read of nothing is not sent to the device. */
+    if (in && !header.length)
+        return complete_ioctl(device, irp, STATUS_SUCCESS, 0);
+
+    if (!(transfer = ExAllocatePool(NonPagedPool, sizeof(*transfer))))
+        return complete_ioctl(device, irp, STATUS_NO_MEMORY, 0);
+    memset(transfer, 0, sizeof(*transfer));
+
+    transfer->device = device;
+    transfer->pipe = pipe;
+    transfer->irp = irp;
+    transfer->type = in ? TRANSFER_READ : TRANSFER_WRITE;
+    transfer->flags = header.flags;
+    transfer->queued = in && !(header.flags & WINE_WINUSB_FLAG_RAW_IO);
+    transfer->total = header.length;
+    transfer->timeout = header.timeout;
+    /* for writes, the data follows the header in the input buffer; reads
+     * are returned at the start of the (shared) system buffer */
+    transfer->buffer = (UCHAR *)irp->AssociatedIrp.SystemBuffer + (in ? 0 : sizeof(header));
+
+    TRACE("%s pipe %#x, length %lu, flags %#x, timeout %lu.\n", in ? "read" : "write", header.pipe,
+            transfer->total, transfer->flags, transfer->timeout);
+
+    IoMarkIrpPending(irp);
+    if (transfer->queued)
+        queue_read(transfer);
+    else if (in)
+        start_read(transfer);
+    else
+    {
+        transfer->abort_count = pipe->abort_count;
+        start_timer(transfer);
+        continue_write(transfer);
+    }
+    return STATUS_PENDING;
+}
+
+static NTSTATUS start_control(struct device *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG in_len = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    struct _URB_CONTROL_TRANSFER *req;
+    struct wine_winusb_control header;
+    struct transfer *transfer;
+    USHORT length;
+    BOOL in;
+
+    if (in_len < sizeof(header))
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+    memcpy(&header, irp->AssociatedIrp.SystemBuffer, sizeof(header));
+
+    in = !!(header.setup[0] & 0x80);
+    length = header.setup[6] | (header.setup[7] << 8);
+
+    TRACE("setup %s, timeout %u.\n", debugstr_setup(header.setup), (unsigned int)header.timeout);
+
+    if (in ? length > out_len : length > in_len - sizeof(header))
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+
+    if (!(transfer = ExAllocatePool(NonPagedPool, sizeof(*transfer))))
+        return complete_ioctl(device, irp, STATUS_NO_MEMORY, 0);
+    memset(transfer, 0, sizeof(*transfer));
+    transfer->device = device;
+    transfer->irp = irp;
+    transfer->type = TRANSFER_CONTROL;
+    transfer->total = transfer->requested = length;
+    transfer->timeout = header.timeout;
+
+    req = &transfer->urb.control;
+    req->Hdr.Length = sizeof(*req);
+    req->Hdr.Function = URB_FUNCTION_CONTROL_TRANSFER;
+    req->TransferFlags = (in ? USBD_TRANSFER_DIRECTION_IN : 0) | USBD_SHORT_TRANSFER_OK;
+    req->TransferBufferLength = length;
+    /* IN data goes at the start of the system buffer, OUT data follows the header */
+    req->TransferBuffer = (UCHAR *)irp->AssociatedIrp.SystemBuffer + (in ? 0 : sizeof(header));
+    memcpy(req->SetupPacket, header.setup, sizeof(req->SetupPacket));
+
+    IoMarkIrpPending(irp);
+    start_timer(transfer);
+    call_lower(transfer);
+    return STATUS_PENDING;
+}
+
+static NTSTATUS pipe_request(struct device *device, IRP *irp, ULONG code)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct wine_winusb_pipe header;
+    NTSTATUS status = STATUS_SUCCESS;
+    struct pipe *pipe;
+
+    if (stack->Parameters.DeviceIoControl.InputBufferLength < sizeof(header))
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+    memcpy(&header, irp->AssociatedIrp.SystemBuffer, sizeof(header));
+
+    if (!(pipe = find_pipe(device, header.pipe)) || !pipe->handle)
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+
+    TRACE("code %#lx, pipe %#x.\n", code, header.pipe);
+
+    switch (code)
+    {
+        case IOCTL_WINE_WINUSB_ABORT_PIPE:
+            abort_queued_reads(device, pipe, STATUS_CANCELLED);
+            status = pipe_request_sync(device, URB_FUNCTION_ABORT_PIPE, pipe->handle);
+            break;
+
+        case IOCTL_WINE_WINUSB_RESET_PIPE:
+            status = pipe_request_sync(device, URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL, pipe->handle);
+            break;
+
+        case IOCTL_WINE_WINUSB_FLUSH_PIPE:
+            discard_stashed_data(pipe);
+            break;
+    }
+    return complete_ioctl(device, irp, status, 0);
+}
+
+static NTSTATUS set_alt_setting(struct device *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct _URB_SELECT_INTERFACE urb = {{0}};
+    struct wine_winusb_alt_setting header;
+    NTSTATUS status;
+
+    if (stack->Parameters.DeviceIoControl.InputBufferLength < sizeof(header))
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+    memcpy(&header, irp->AssociatedIrp.SystemBuffer, sizeof(header));
+
+    if (!interface_is_ours(device, header.interface))
+        return complete_ioctl(device, irp, STATUS_INVALID_PARAMETER, 0);
+
+    TRACE("interface %u, alternate setting %u.\n", header.interface, header.alt_setting);
+
+    /* The pipe handles don't depend on the alternate setting. */
+    urb.Hdr.Length = sizeof(urb);
+    urb.Hdr.Function = URB_FUNCTION_SELECT_INTERFACE;
+    urb.Interface.Length = FIELD_OFFSET(USBD_INTERFACE_INFORMATION, Pipes);
+    urb.Interface.InterfaceNumber = header.interface;
+    urb.Interface.AlternateSetting = header.alt_setting;
+
+    /* Completes synchronously in wineusb.sys. */
+    status = submit_urb_sync(device, &urb.Hdr);
+    return complete_ioctl(device, irp, status, 0);
+}
+
+static NTSTATUS get_info(struct device *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    struct wine_winusb_info *info = irp->AssociatedIrp.SystemBuffer;
+    ULONG size = sizeof(*info) + device->config_len;
+
+    if (out_len < size)
+        return complete_ioctl(device, irp, STATUS_BUFFER_TOO_SMALL, 0);
+
+    memset(info, 0, sizeof(*info));
+    info->size = size;
+    info->speed = device->speed;
+    info->interface_count = device->interface_count;
+    info->config_length = device->config_len;
+    memcpy(info->interfaces, device->interfaces, device->interface_count);
+    memcpy(info->device_descriptor, device->device_desc, sizeof(info->device_descriptor));
+    memcpy(info + 1, device->config, device->config_len);
+
+    return complete_ioctl(device, irp, STATUS_SUCCESS, size);
+}
+
+static NTSTATUS WINAPI driver_ioctl(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    struct device *device = device_obj->DeviceExtension;
+
+    TRACE("device %p, irp %p, code %#lx.\n", device_obj, irp, code);
+
+    InterlockedIncrement(&device->io_count);
+
+    if (device->removed)
+        return complete_ioctl(device, irp, STATUS_DEVICE_NOT_CONNECTED, 0);
+    if (!device->started)
+        return complete_ioctl(device, irp, STATUS_DEVICE_NOT_READY, 0);
+
+    switch (code)
+    {
+        case IOCTL_WINE_WINUSB_GET_INFO:
+            return get_info(device, irp);
+        case IOCTL_WINE_WINUSB_CONTROL:
+            return start_control(device, irp);
+        case IOCTL_WINE_WINUSB_READ_PIPE:
+            return start_bulk(device, irp, TRUE);
+        case IOCTL_WINE_WINUSB_WRITE_PIPE:
+            return start_bulk(device, irp, FALSE);
+        case IOCTL_WINE_WINUSB_ABORT_PIPE:
+        case IOCTL_WINE_WINUSB_RESET_PIPE:
+        case IOCTL_WINE_WINUSB_FLUSH_PIPE:
+            return pipe_request(device, irp, code);
+        case IOCTL_WINE_WINUSB_SET_ALT:
+            return set_alt_setting(device, irp);
+        default:
+            FIXME("Unhandled ioctl %#lx.\n", code);
+            return complete_ioctl(device, irp, STATUS_NOT_SUPPORTED, 0);
+    }
+}
+
+/* Stops everything that is in flight, and waits until no request uses the
+ * device anymore. device->removed must be set, so that nothing new starts. */
+static void wait_for_io(struct device *device)
+{
+    LARGE_INTEGER interval;
+    unsigned int i;
+
+    for (i = 0; i < device->pipe_count; ++i)
+        abort_queued_reads(device, &device->pipes[i], STATUS_DEVICE_NOT_CONNECTED);
+    /* everything, including control transfers; fails if the lower device
+     * has already been removed, which did the same */
+    pipe_request_sync(device, URB_FUNCTION_ABORT_PIPE, NULL);
+
+    interval.QuadPart = -10 * 10000;
+    while (device->io_count)
+        KeDelayExecutionThread(KernelMode, FALSE, &interval);
+}
+
+static NTSTATUS WINAPI driver_pnp(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct device *device = device_obj->DeviceExtension;
+    NTSTATUS status;
+    unsigned int i;
+
+    TRACE("device %p, irp %p, minor function %#x.\n", device_obj, irp, stack->MinorFunction);
+
+    switch (stack->MinorFunction)
+    {
+        case IRP_MN_START_DEVICE:
+            if ((status = forward_irp_sync(device, irp)))
+            {
+                irp->IoStatus.Status = status;
+                IoCompleteRequest(irp, IO_NO_INCREMENT);
+                return status;
+            }
+
+            if (!(status = init_usb_device(device)))
+            {
+                if (!device->iface_count)
+                    register_device_interfaces(device);
+                device->started = TRUE;
+                set_interfaces_state(device, TRUE);
+            }
+
+            irp->IoStatus.Status = status;
+            IoCompleteRequest(irp, IO_NO_INCREMENT);
+            return status;
+
+        case IRP_MN_SURPRISE_REMOVAL:
+            device->removed = TRUE;
+            set_interfaces_state(device, FALSE);
+            irp->IoStatus.Status = STATUS_SUCCESS;
+            IoSkipCurrentIrpStackLocation(irp);
+            return IoCallDriver(device->lower, irp);
+
+        case IRP_MN_REMOVE_DEVICE:
+            device->removed = TRUE;
+            set_interfaces_state(device, FALSE);
+            wait_for_io(device);
+
+            irp->IoStatus.Status = STATUS_SUCCESS;
+            IoSkipCurrentIrpStackLocation(irp);
+            status = IoCallDriver(device->lower, irp);
+
+            for (i = 0; i < device->iface_count; ++i)
+                RtlFreeUnicodeString(&device->iface_names[i]);
+            free_stashed_data(device);
+            if (device->config)
+                ExFreePool(device->config);
+            IoDetachDevice(device->lower);
+            IoDeleteDevice(device->device);
+            return status;
+
+        default:
+            IoSkipCurrentIrpStackLocation(irp);
+            return IoCallDriver(device->lower, irp);
+    }
+}
+
+static NTSTATUS WINAPI driver_create_close(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    struct device *device = device_obj->DeviceExtension;
+
+    TRACE("device %p, irp %p, major %#x.\n", device_obj, irp, stack->MajorFunction);
+
+    if (stack->MajorFunction == IRP_MJ_CREATE && (device->removed || !device->started))
+        return complete_request(irp, STATUS_DELETE_PENDING, 0);
+    return complete_request(irp, STATUS_SUCCESS, 0);
+}
+
+static NTSTATUS WINAPI driver_add_device(DRIVER_OBJECT *driver, DEVICE_OBJECT *pdo)
+{
+    struct device *device;
+    DEVICE_OBJECT *fdo;
+    NTSTATUS status;
+
+    TRACE("driver %p, pdo %p.\n", driver, pdo);
+
+    if ((status = IoCreateDevice(driver, sizeof(*device), NULL, FILE_DEVICE_USB, 0, FALSE, &fdo)))
+    {
+        ERR("Failed to create FDO, status %#lx.\n", status);
+        return status;
+    }
+
+    device = fdo->DeviceExtension;
+    memset(device, 0, sizeof(*device));
+    device->device = fdo;
+    device->pdo = pdo;
+    device->lower = IoAttachDeviceToDeviceStack(fdo, pdo);
+
+    fdo->Flags |= DO_BUFFERED_IO;
+    fdo->Flags &= ~DO_DEVICE_INITIALIZING;
+    return STATUS_SUCCESS;
+}
+
+static void WINAPI driver_unload(DRIVER_OBJECT *driver)
+{
+    TRACE("driver %p.\n", driver);
+}
+
+NTSTATUS WINAPI DriverEntry(DRIVER_OBJECT *driver, UNICODE_STRING *path)
+{
+    TRACE("driver %p, path %s.\n", driver, debugstr_w(path->Buffer));
+
+    driver->DriverExtension->AddDevice = driver_add_device;
+    driver->DriverUnload = driver_unload;
+    driver->MajorFunction[IRP_MJ_PNP] = driver_pnp;
+    driver->MajorFunction[IRP_MJ_CREATE] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_CLOSE] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_CLEANUP] = driver_create_close;
+    driver->MajorFunction[IRP_MJ_DEVICE_CONTROL] = driver_ioctl;
+
+    return STATUS_SUCCESS;
+}
