+#define INTERFACE_MAGIC 0x57555342 /* 'WUSB' */
+#define MAX_INFO_SIZE 65536
+#define DEFAULT_CONTROL_TIMEOUT 5000
+#define REPORTED_MAX_TRANSFER_SIZE (4 * 1024 * 1024)
+
+struct pipe_policy
+{
+    BOOL short_packet_terminate;
+    BOOL auto_clear_stall;
+    BOOL ignore_short_packets;
+    BOOL allow_partial_reads;
+    BOOL auto_flush;
+    BOOL raw_io;
+    BOOL reset_pipe_on_resume;
+    ULONG timeout;
+};
+
+struct device
+{
+    LONG refcount;
+    HANDLE file;
+    struct wine_winusb_info *info;
+    const UCHAR *config;
+};
+
+struct interface
+{
+    DWORD magic;
+    struct device *device;
+    UCHAR index;    /* index into info->interfaces */
+    UCHAR number;   /* bInterfaceNumber */
+    UCHAR alt;      /* current alternate setting index */
+    UCHAR auto_suspend;
+    ULONG suspend_delay;
+    struct pipe_policy policies[32];
+};
+
+static struct interface *get_interface(WINUSB_INTERFACE_HANDLE handle)
+{
+    struct interface *iface = handle;
+
+    if (!iface || iface->magic != INTERFACE_MAGIC)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return NULL;
+    }
+    return iface;
+}
+
+static unsigned int pipe_index(UCHAR pipe)
+{
+    return (pipe & 0x0f) | ((pipe & 0x80) >> 3);
+}
+
+static struct pipe_policy *get_policy(struct interface *iface, UCHAR pipe)
+{
+    return &iface->policies[pipe_index(pipe)];
+}
+
+/* Descriptor helpers */
+
+static const UCHAR *config_end(const struct device *device)
+{
+    return device->config + device->info->config_length;
+}
+
+static const USB_INTERFACE_DESCRIPTOR *find_interface_desc(const struct device *device, UCHAR number, UCHAR alt_index)
+{
+    const UCHAR *ptr = device->config, *end = config_end(device);
+    unsigned int count = 0;
+
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == USB_INTERFACE_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            const USB_INTERFACE_DESCRIPTOR *desc = (const USB_INTERFACE_DESCRIPTOR *)ptr;
+
+            if (desc->bInterfaceNumber == number && count++ == alt_index)
+                return desc;
+        }
+        ptr += ptr[0];
+    }
+    return NULL;
+}
+
+static const USB_ENDPOINT_DESCRIPTOR *find_endpoint_desc(const struct device *device,
+        const USB_INTERFACE_DESCRIPTOR *iface, unsigned int index)
+{
+    const UCHAR *ptr = (const UCHAR *)iface + iface->bLength, *end = config_end(device);
+    unsigned int count = 0;
+
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == USB_INTERFACE_DESCRIPTOR_TYPE)
+            break;
+        if (ptr[1] == USB_ENDPOINT_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_ENDPOINT_DESCRIPTOR))
+        {
+            if (count++ == index)
+                return (const USB_ENDPOINT_DESCRIPTOR *)ptr;
+        }
+        ptr += ptr[0];
+    }
+    return NULL;
+}
+
+/* Find the endpoint descriptor of a pipe in the interface's current setting. */
+static const USB_ENDPOINT_DESCRIPTOR *find_pipe_desc(const struct interface *iface, UCHAR pipe)
+{
+    const USB_INTERFACE_DESCRIPTOR *desc;
+    const USB_ENDPOINT_DESCRIPTOR *ep;
+    unsigned int i;
+
+    if (!(desc = find_interface_desc(iface->device, iface->number, iface->alt)))
+        return NULL;
+    for (i = 0; (ep = find_endpoint_desc(iface->device, desc, i)); ++i)
+    {
+        if (ep->bEndpointAddress == pipe)
+            return ep;
+    }
+    return NULL;
+}
+
+/* I/O helpers */
+
+static BOOL do_ioctl(struct device *device, DWORD code, void *in, DWORD in_len,
+        void *out, DWORD out_len, ULONG *ret_len, OVERLAPPED *user_ov, ULONG timeout)
+{
+    OVERLAPPED ov = {0};
+    DWORD len = 0, err;
+    BOOL ret;
+
+    if (user_ov)
+    {
+        ret = DeviceIoControl(device->file, code, in, in_len, out, out_len, &len, user_ov);
+        if (ret_len) *ret_len = len;
+        return ret;
+    }
+
+    if (!(ov.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL)))
+        return FALSE;
+
+    ret = DeviceIoControl(device->file, code, in, in_len, out, out_len, &len, &ov);
+    if (!ret && GetLastError() == ERROR_IO_PENDING)
+    {
+        if (WaitForSingleObject(ov.hEvent, timeout ? timeout : INFINITE) == WAIT_TIMEOUT)
+        {
+            TRACE("ioctl %#lx timed out after %lu ms.\n", code, timeout);
+            CancelIoEx(device->file, &ov);
+            GetOverlappedResult(device->file, &ov, &len, TRUE);
+            ret = FALSE;
+            err = ERROR_SEM_TIMEOUT;
+        }
+        else
+        {
+            ret = GetOverlappedResult(device->file, &ov, &len, FALSE);
+            err = GetLastError();
+        }
+    }
+    else
+        err = GetLastError();
+
+    CloseHandle(ov.hEvent);
+    if (ret_len) *ret_len = len;
+    if (!ret) SetLastError(err);
+    return ret;
+}
+
+static void release_device(struct device *device)
+{
+    if (InterlockedDecrement(&device->refcount))
+        return;
+    free(device->info);
+    free(device);
+}
+
+static struct interface *create_interface(struct device *device, UCHAR index)
+{
+    struct interface *iface;
+    unsigned int i;
+
+    if (!(iface = calloc(1, sizeof(*iface))))
+        return NULL;
+
+    InterlockedIncrement(&device->refcount);
+    iface->magic = INTERFACE_MAGIC;
+    iface->device = device;
+    iface->index = index;
+    iface->number = device->info->interfaces[index];
+    iface->alt = 0;
+    iface->auto_suspend = 1;
+    iface->suspend_delay = 5000;
+    for (i = 0; i < ARRAY_SIZE(iface->policies); ++i)
+        iface->policies[i].allow_partial_reads = TRUE;
+    iface->policies[0].timeout = DEFAULT_CONTROL_TIMEOUT;
+    return iface;
+}
+
+/***********************************************************************
+ *           WinUsb_Initialize (winusb.@)
+ */
+BOOL WINAPI WinUsb_Initialize(HANDLE file, PWINUSB_INTERFACE_HANDLE handle)
+{
+    struct wine_winusb_info *info;
+    struct device *device;
+    struct interface *iface;
+    ULONG len;
+
+    TRACE("file %p, handle %p.\n", file, handle);
+
+    if (!handle || !file || file == INVALID_HANDLE_VALUE)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    if (!(device = calloc(1, sizeof(*device))) || !(info = malloc(MAX_INFO_SIZE)))
+    {
+        free(device);
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    device->file = file;
+    device->refcount = 1;
+
+    if (!do_ioctl(device, IOCTL_WINE_WINUSB_GET_INFO, NULL, 0, info, MAX_INFO_SIZE, &len, NULL, 0))
+    {
+        DWORD err = GetLastError();
+        WARN("Failed to get device information, error %lu; is winusb.sys loaded for this device?\n", err);
+        free(info);
+        free(device);
+        SetLastError(err == ERROR_INVALID_FUNCTION || err == ERROR_NOT_SUPPORTED ? ERROR_INVALID_HANDLE : err);
+        return FALSE;
+    }
+
+    if (len < sizeof(*info) || info->size > len || !info->interface_count)
+    {
+        ERR("Invalid device information (length %lu, interfaces %u).\n", len, len >= sizeof(*info) ? info->interface_count : 0);
+        free(info);
+        free(device);
+        SetLastError(ERROR_GEN_FAILURE);
+        return FALSE;
+    }
+
+    device->info = info;
+    device->config = (const UCHAR *)(info + 1);
+
+    TRACE("device %04x:%04x, %u interface(s), first %u, config length %u.\n",
+            ((USB_DEVICE_DESCRIPTOR *)info->device_descriptor)->idVendor,
+            ((USB_DEVICE_DESCRIPTOR *)info->device_descriptor)->idProduct,
+            info->interface_count, info->interfaces[0], info->config_length);
+
+    iface = create_interface(device, 0);
+    release_device(device); /* now owned by the interface */
+    if (!iface)
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+
+    *handle = iface;
+    TRACE("Returning interface %p.\n", iface);
+    return TRUE;
+}
+
 /***********************************************************************
  *           WinUsb_Free (winusb.@)
  */
 BOOL WINAPI WinUsb_Free(WINUSB_INTERFACE_HANDLE handle)
 {
-    FIXME( "(%p) - stub\n", handle );
+    struct interface *iface;
+
+    TRACE("handle %p.\n", handle);
+
+    if (!handle) return TRUE;
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+
+    iface->magic = 0;
+    release_device(iface->device);
+    free(iface);
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetAssociatedInterface (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetAssociatedInterface(WINUSB_INTERFACE_HANDLE handle, UCHAR index,
+        PWINUSB_INTERFACE_HANDLE ret)
+{
+    struct interface *iface, *assoc;
+    unsigned int target;
+
+    TRACE("handle %p, index %u, ret %p.\n", handle, index, ret);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!ret)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    target = iface->index + 1 + index;
+    if (target >= iface->device->info->interface_count)
+    {
+        SetLastError(ERROR_NO_MORE_ITEMS);
+        return FALSE;
+    }
+
+    if (!(assoc = create_interface(iface->device, target)))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    *ret = assoc;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_QueryInterfaceSettings (winusb.@)
+ */
+BOOL WINAPI WinUsb_QueryInterfaceSettings(WINUSB_INTERFACE_HANDLE handle, UCHAR alt,
+        PUSB_INTERFACE_DESCRIPTOR desc)
+{
+    const USB_INTERFACE_DESCRIPTOR *found;
+    struct interface *iface;
+
+    TRACE("handle %p, alt %u, desc %p.\n", handle, alt, desc);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!desc)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    if (!(found = find_interface_desc(iface->device, iface->number, alt)))
+    {
+        SetLastError(ERROR_NO_MORE_ITEMS);
+        return FALSE;
+    }
+    memcpy(desc, found, sizeof(*desc));
+    return TRUE;
+}
+
+static BOOL query_pipe(WINUSB_INTERFACE_HANDLE handle, UCHAR alt, UCHAR index, WINUSB_PIPE_INFORMATION_EX *info)
+{
+    const USB_INTERFACE_DESCRIPTOR *desc;
+    const USB_ENDPOINT_DESCRIPTOR *ep;
+    struct interface *iface;
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!info)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    if (!(desc = find_interface_desc(iface->device, iface->number, alt))
+            || !(ep = find_endpoint_desc(iface->device, desc, index)))
+    {
+        SetLastError(ERROR_NO_MORE_ITEMS);
+        return FALSE;
+    }
+
+    info->PipeType = ep->bmAttributes & USB_ENDPOINT_TYPE_MASK;
+    info->PipeId = ep->bEndpointAddress;
+    info->MaximumPacketSize = ep->wMaxPacketSize & 0x7ff;
+    info->Interval = ep->bInterval;
+    info->MaximumBytesPerInterval = (ep->wMaxPacketSize & 0x7ff) * (((ep->wMaxPacketSize >> 11) & 3) + 1);
+    TRACE("pipe %#x, type %u, max packet %u.\n", info->PipeId, info->PipeType, info->MaximumPacketSize);
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_QueryPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_QueryPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR alt, UCHAR index,
+        PWINUSB_PIPE_INFORMATION info)
+{
+    WINUSB_PIPE_INFORMATION_EX info_ex;
+
+    TRACE("handle %p, alt %u, index %u, info %p.\n", handle, alt, index, info);
+
+    if (!info)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!query_pipe(handle, alt, index, &info_ex))
+        return FALSE;
+
+    info->PipeType = info_ex.PipeType;
+    info->PipeId = info_ex.PipeId;
+    info->MaximumPacketSize = info_ex.MaximumPacketSize;
+    info->Interval = info_ex.Interval;
     return TRUE;
 }
+
+/***********************************************************************
+ *           WinUsb_QueryPipeEx (winusb.@)
+ */
+BOOL WINAPI WinUsb_QueryPipeEx(WINUSB_INTERFACE_HANDLE handle, UCHAR alt, UCHAR index,
+        PWINUSB_PIPE_INFORMATION_EX info)
+{
+    TRACE("handle %p, alt %u, index %u, info %p.\n", handle, alt, index, info);
+    return query_pipe(handle, alt, index, info);
+}
+
+static BOOL control_transfer(struct interface *iface, WINUSB_SETUP_PACKET setup, UCHAR *buffer,
+        ULONG length, ULONG *ret_len, OVERLAPPED *ov)
+{
+    struct wine_winusb_control *header;
+    ULONG transferred = 0;
+    BOOL in = !!(setup.RequestType & 0x80), ret;
+    USHORT data_len;
+
+    data_len = buffer ? min(setup.Length, length) : 0;
+    setup.Length = data_len;
+
+    /* WinUSB directs interface requests to the interface of the handle. */
+    if ((setup.RequestType & 0x1f) == 1)
+        setup.Index = (setup.Index & 0xff00) | iface->number;
+
+    TRACE("setup {%02x %02x %04x %04x %04x}.\n", setup.RequestType, setup.Request,
+            setup.Value, setup.Index, setup.Length);
+
+    if (!(header = malloc(sizeof(*header) + (in ? 0 : data_len))))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    memset(header, 0, sizeof(*header));
+    memcpy(header->setup, &setup, sizeof(header->setup));
+    if (!in && data_len)
+        memcpy(header + 1, buffer, data_len);
+
+    ret = do_ioctl(iface->device, IOCTL_WINE_WINUSB_CONTROL, header, sizeof(*header) + (in ? 0 : data_len),
+            in ? buffer : NULL, in ? data_len : 0, &transferred, ov, iface->policies[0].timeout);
+    free(header);
+
+    if (ret_len) *ret_len = transferred;
+    return ret;
+}
+
+/***********************************************************************
+ *           WinUsb_ControlTransfer (winusb.@)
+ */
+BOOL WINAPI WinUsb_ControlTransfer(WINUSB_INTERFACE_HANDLE handle, WINUSB_SETUP_PACKET setup,
+        PUCHAR buffer, ULONG length, PULONG ret_len, LPOVERLAPPED ov)
+{
+    struct interface *iface;
+
+    TRACE("handle %p, buffer %p, length %lu, ret_len %p, ov %p.\n", handle, buffer, length, ret_len, ov);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    return control_transfer(iface, setup, buffer, length, ret_len, ov);
+}
+
+/***********************************************************************
+ *           WinUsb_GetDescriptor (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetDescriptor(WINUSB_INTERFACE_HANDLE handle, UCHAR type, UCHAR index,
+        USHORT lang, PUCHAR buffer, ULONG length, PULONG ret_len)
+{
+    struct wine_winusb_info *info;
+    WINUSB_SETUP_PACKET setup;
+    struct interface *iface;
+    ULONG len;
+
+    TRACE("handle %p, type %#x, index %u, lang %#x, buffer %p, length %lu, ret_len %p.\n",
+            handle, type, index, lang, buffer, length, ret_len);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!buffer || !ret_len)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    info = iface->device->info;
+
+    if (type == USB_DEVICE_DESCRIPTOR_TYPE)
+    {
+        len = min(length, sizeof(info->device_descriptor));
+        memcpy(buffer, info->device_descriptor, len);
+        *ret_len = len;
+        return TRUE;
+    }
+    if (type == USB_CONFIGURATION_DESCRIPTOR_TYPE && !index)
+    {
+        len = min(length, info->config_length);
+        memcpy(buffer, iface->device->config, len);
+        *ret_len = len;
+        return TRUE;
+    }
+
+    setup.RequestType = 0x80;
+    setup.Request = 6; /* GET_DESCRIPTOR */
+    setup.Value = (type << 8) | index;
+    setup.Index = lang;
+    setup.Length = min(length, 0xffff);
+    return control_transfer(iface, setup, buffer, length, ret_len, NULL);
+}
+
+static BOOL check_pipe(struct interface *iface, UCHAR pipe, BOOL in)
+{
+    const USB_ENDPOINT_DESCRIPTOR *ep;
+
+    if (!(ep = find_pipe_desc(iface, pipe)) || !!(pipe & 0x80) != in)
+    {
+        WARN("Invalid pipe %#x.\n", pipe);
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_ReadPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_ReadPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe, PUCHAR buffer,
+        ULONG length, PULONG ret_len, LPOVERLAPPED ov)
+{
+    struct wine_winusb_transfer header = {0};
+    struct pipe_policy *policy;
+    struct interface *iface;
+    ULONG transferred = 0;
+    BOOL ret;
+
+    TRACE("handle %p, pipe %#x, buffer %p, length %lu, ret_len %p, ov %p.\n",
+            handle, pipe, buffer, length, ret_len, ov);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!check_pipe(iface, pipe, TRUE))
+        return FALSE;
+    if (!buffer && length)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    policy = get_policy(iface, pipe);
+
+    header.pipe = pipe;
+    header.flags = WINE_WINUSB_FLAG_SHORT_OK;
+    header.length = length;
+
+    ret = do_ioctl(iface->device, IOCTL_WINE_WINUSB_READ_PIPE, &header, sizeof(header),
+            buffer, length, &transferred, ov, policy->timeout);
+
+    TRACE("ret %d, transferred %lu, error %lu.\n", ret, transferred, ret ? 0 : GetLastError());
+
+    if (!ret && !ov && GetLastError() != ERROR_IO_PENDING && policy->auto_clear_stall)
+        WinUsb_ResetPipe(handle, pipe);
+
+    if (ret_len) *ret_len = transferred;
+    return ret;
+}
+
+/***********************************************************************
+ *           WinUsb_WritePipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_WritePipe(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe, PUCHAR buffer,
+        ULONG length, PULONG ret_len, LPOVERLAPPED ov)
+{
+    struct wine_winusb_transfer *header;
+    struct pipe_policy *policy;
+    struct interface *iface;
+    ULONG transferred = 0;
+    BOOL ret;
+
+    TRACE("handle %p, pipe %#x, buffer %p, length %lu, ret_len %p, ov %p.\n",
+            handle, pipe, buffer, length, ret_len, ov);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!check_pipe(iface, pipe, FALSE))
+        return FALSE;
+    if (!buffer && length)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    policy = get_policy(iface, pipe);
+
+    /* The input buffer is copied when the request is queued, so it can be
+     * freed right away even for overlapped requests. */
+    if (!(header = malloc(sizeof(*header) + length)))
+    {
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+        return FALSE;
+    }
+    memset(header, 0, sizeof(*header));
+    header->pipe = pipe;
+    header->length = length;
+    if (policy->short_packet_terminate)
+        header->flags |= WINE_WINUSB_FLAG_ZLP;
+    if (length)
+        memcpy(header + 1, buffer, length);
+
+    ret = do_ioctl(iface->device, IOCTL_WINE_WINUSB_WRITE_PIPE, header, sizeof(*header) + length,
+            NULL, 0, &transferred, ov, policy->timeout);
+    free(header);
+
+    TRACE("ret %d, transferred %lu, error %lu.\n", ret, transferred, ret ? 0 : GetLastError());
+
+    if (!ret && !ov && GetLastError() != ERROR_IO_PENDING && policy->auto_clear_stall)
+        WinUsb_ResetPipe(handle, pipe);
+
+    if (ret_len) *ret_len = transferred;
+    return ret;
+}
+
+static BOOL pipe_request(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe, DWORD code)
+{
+    struct wine_winusb_pipe header = {0};
+    struct interface *iface;
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!find_pipe_desc(iface, pipe))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    header.pipe = pipe;
+    return do_ioctl(iface->device, code, &header, sizeof(header), NULL, 0, NULL, NULL, 0);
+}
+
+/***********************************************************************
+ *           WinUsb_AbortPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_AbortPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe)
+{
+    TRACE("handle %p, pipe %#x.\n", handle, pipe);
+    return pipe_request(handle, pipe, IOCTL_WINE_WINUSB_ABORT_PIPE);
+}
+
+/***********************************************************************
+ *           WinUsb_ResetPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_ResetPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe)
+{
+    TRACE("handle %p, pipe %#x.\n", handle, pipe);
+    return pipe_request(handle, pipe, IOCTL_WINE_WINUSB_RESET_PIPE);
+}
+
+/***********************************************************************
+ *           WinUsb_FlushPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_FlushPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe)
+{
+    struct interface *iface;
+
+    TRACE("handle %p, pipe %#x.\n", handle, pipe);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    /* Nothing is cached by this implementation. */
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetOverlappedResult (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetOverlappedResult(WINUSB_INTERFACE_HANDLE handle, LPOVERLAPPED ov,
+        LPDWORD ret_len, BOOL wait)
+{
+    struct interface *iface;
+
+    TRACE("handle %p, ov %p, ret_len %p, wait %d.\n", handle, ov, ret_len, wait);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    return GetOverlappedResult(iface->device->file, ov, ret_len, wait);
+}
+
+/* boolean policies are passed as a single UCHAR */
+static BOOL set_flag(BOOL *dst, ULONG length, const void *value)
+{
+    if (!value || length < sizeof(UCHAR))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    *dst = !!*(const UCHAR *)value;
+    return TRUE;
+}
+
+static BOOL set_ulong(ULONG *dst, ULONG length, const void *value)
+{
+    if (!value || length < sizeof(ULONG))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    memcpy(dst, value, sizeof(ULONG));
+    return TRUE;
+}
+
+static BOOL get_value(const void *src, ULONG size, ULONG *length, void *value)
+{
+    if (!length || !value)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (*length < size)
+    {
+        *length = size;
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+    memcpy(value, src, size);
+    *length = size;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_SetPipePolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_SetPipePolicy(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe, ULONG type,
+        ULONG length, PVOID value)
+{
+    struct pipe_policy *policy;
+    struct interface *iface;
+
+    TRACE("handle %p, pipe %#x, type %#lx, length %lu, value %p.\n", handle, pipe, type, length, value);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    policy = get_policy(iface, pipe);
+
+    switch (type)
+    {
+        case SHORT_PACKET_TERMINATE: return set_flag(&policy->short_packet_terminate, length, value);
+        case AUTO_CLEAR_STALL:       return set_flag(&policy->auto_clear_stall, length, value);
+        case IGNORE_SHORT_PACKETS:   return set_flag(&policy->ignore_short_packets, length, value);
+        case ALLOW_PARTIAL_READS:    return set_flag(&policy->allow_partial_reads, length, value);
+        case AUTO_FLUSH:             return set_flag(&policy->auto_flush, length, value);
+        case RAW_IO:                 return set_flag(&policy->raw_io, length, value);
+        case RESET_PIPE_ON_RESUME:   return set_flag(&policy->reset_pipe_on_resume, length, value);
+        case PIPE_TRANSFER_TIMEOUT:  return set_ulong(&policy->timeout, length, value);
+    }
+
+    FIXME("Unhandled policy %#lx.\n", type);
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetPipePolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetPipePolicy(WINUSB_INTERFACE_HANDLE handle, UCHAR pipe, ULONG type,
+        PULONG length, PVOID value)
+{
+    static const ULONG max_transfer = REPORTED_MAX_TRANSFER_SIZE;
+    struct pipe_policy *policy;
+    struct interface *iface;
+    UCHAR flag;
+
+    TRACE("handle %p, pipe %#x, type %#lx, length %p, value %p.\n", handle, pipe, type, length, value);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    policy = get_policy(iface, pipe);
+
+    switch (type)
+    {
+        case SHORT_PACKET_TERMINATE: flag = policy->short_packet_terminate; break;
+        case AUTO_CLEAR_STALL:       flag = policy->auto_clear_stall; break;
+        case IGNORE_SHORT_PACKETS:   flag = policy->ignore_short_packets; break;
+        case ALLOW_PARTIAL_READS:    flag = policy->allow_partial_reads; break;
+        case AUTO_FLUSH:             flag = policy->auto_flush; break;
+        case RAW_IO:                 flag = policy->raw_io; break;
+        case RESET_PIPE_ON_RESUME:   flag = policy->reset_pipe_on_resume; break;
+        case PIPE_TRANSFER_TIMEOUT:  return get_value(&policy->timeout, sizeof(ULONG), length, value);
+        case MAXIMUM_TRANSFER_SIZE:  return get_value(&max_transfer, sizeof(ULONG), length, value);
+        default:
+            FIXME("Unhandled policy %#lx.\n", type);
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+    }
+    return get_value(&flag, sizeof(flag), length, value);
+}
+
+/***********************************************************************
+ *           WinUsb_SetPowerPolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_SetPowerPolicy(WINUSB_INTERFACE_HANDLE handle, ULONG type, ULONG length, PVOID value)
+{
+    struct interface *iface;
+
+    TRACE("handle %p, type %#lx, length %lu, value %p.\n", handle, type, length, value);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+
+    switch (type)
+    {
+        case AUTO_SUSPEND:
+            if (!value || length < 1) break;
+            iface->auto_suspend = *(UCHAR *)value;
+            return TRUE;
+        case SUSPEND_DELAY:
+            return set_ulong(&iface->suspend_delay, length, value);
+    }
+
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetPowerPolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetPowerPolicy(WINUSB_INTERFACE_HANDLE handle, ULONG type, PULONG length, PVOID value)
+{
+    struct interface *iface;
+
+    TRACE("handle %p, type %#lx, length %p, value %p.\n", handle, type, length, value);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+
+    switch (type)
+    {
+        case AUTO_SUSPEND:  return get_value(&iface->auto_suspend, sizeof(UCHAR), length, value);
+        case SUSPEND_DELAY: return get_value(&iface->suspend_delay, sizeof(ULONG), length, value);
+    }
+
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_QueryDeviceInformation (winusb.@)
+ */
+BOOL WINAPI WinUsb_QueryDeviceInformation(WINUSB_INTERFACE_HANDLE handle, ULONG type, PULONG length, PVOID value)
+{
+    struct interface *iface;
+
+    TRACE("handle %p, type %#lx, length %p, value %p.\n", handle, type, length, value);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+
+    if (type == DEVICE_SPEED)
+        return get_value(&iface->device->info->speed, sizeof(UCHAR), length, value);
+
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetCurrentAlternateSetting (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetCurrentAlternateSetting(WINUSB_INTERFACE_HANDLE handle, PUCHAR alt)
+{
+    struct interface *iface;
+
+    TRACE("handle %p, alt %p.\n", handle, alt);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!alt)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    *alt = iface->alt;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_SetCurrentAlternateSetting (winusb.@)
+ */
+BOOL WINAPI WinUsb_SetCurrentAlternateSetting(WINUSB_INTERFACE_HANDLE handle, UCHAR alt)
+{
+    const USB_INTERFACE_DESCRIPTOR *desc;
+    WINUSB_SETUP_PACKET setup;
+    struct interface *iface;
+
+    TRACE("handle %p, alt %u.\n", handle, alt);
+
+    if (!(iface = get_interface(handle)))
+        return FALSE;
+    if (!(desc = find_interface_desc(iface->device, iface->number, alt)))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (alt == iface->alt)
+        return TRUE;
+
+    setup.RequestType = 0x01;
+    setup.Request = 11; /* SET_INTERFACE */
+    setup.Value = desc->bAlternateSetting;
+    setup.Index = iface->number;
+    setup.Length = 0;
+    if (!control_transfer(iface, setup, NULL, 0, NULL, NULL))
+        return FALSE;
+    iface->alt = alt;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_ParseConfigurationDescriptor (winusb.@)
+ */
+PUSB_INTERFACE_DESCRIPTOR WINAPI WinUsb_ParseConfigurationDescriptor(PUSB_CONFIGURATION_DESCRIPTOR config,
+        PVOID start, LONG number, LONG alt, LONG class, LONG subclass, LONG protocol)
+{
+    const UCHAR *ptr = start, *end;
+
+    TRACE("config %p, start %p, number %ld, alt %ld, class %ld, subclass %ld, protocol %ld.\n",
+            config, start, number, alt, class, subclass, protocol);
+
+    if (!config) return NULL;
+    end = (const UCHAR *)config + config->wTotalLength;
+    if (!ptr) ptr = (const UCHAR *)config;
+
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == USB_INTERFACE_DESCRIPTOR_TYPE && ptr[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            USB_INTERFACE_DESCRIPTOR *desc = (USB_INTERFACE_DESCRIPTOR *)ptr;
+
+            if ((number == -1 || desc->bInterfaceNumber == number)
+                    && (alt == -1 || desc->bAlternateSetting == alt)
+                    && (class == -1 || desc->bInterfaceClass == class)
+                    && (subclass == -1 || desc->bInterfaceSubClass == subclass)
+                    && (protocol == -1 || desc->bInterfaceProtocol == protocol))
+                return desc;
+        }
+        ptr += ptr[0];
+    }
+    return NULL;
+}
+
+/***********************************************************************
+ *           WinUsb_ParseDescriptors (winusb.@)
+ */
+PUSB_COMMON_DESCRIPTOR WINAPI WinUsb_ParseDescriptors(PVOID buffer, ULONG length, PVOID start, LONG type)
+{
+    const UCHAR *ptr = start, *end = (const UCHAR *)buffer + length;
+
+    TRACE("buffer %p, length %lu, start %p, type %ld.\n", buffer, length, start, type);
+
+    if (!buffer) return NULL;
+    if (!ptr) ptr = buffer;
+
+    while (ptr + 2 <= end && ptr[0] >= 2 && ptr + ptr[0] <= end)
+    {
+        if (ptr[1] == type)
+            return (PUSB_COMMON_DESCRIPTOR)ptr;
+        ptr += ptr[0];
+    }
+    return NULL;
+}
