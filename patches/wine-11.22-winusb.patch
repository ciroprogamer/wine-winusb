diff --git a/include/wine/winusb_ioctl.h b/include/wine/winusb_ioctl.h
new file mode 100644
index 0000000..36c230c
--- /dev/null
+++ b/include/wine/winusb_ioctl.h
@@ -0,0 +1,100 @@
+/*
+ * Private interfaces between winusb.dll, winusb.sys and wineusb.sys
+ *
+ * Copyright 2026 ciroprogamer
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINUSB_IOCTL_H
+#define __WINE_WINUSB_IOCTL_H
+
+#include "winioctl.h"
+
+/* Interface between winusb.dll and winusb.sys.
+ *
+ * All structures are pointer-free and fixed-size so that 32-bit clients
+ * can talk to the 64-bit driver. */
+
+#define IOCTL_WINE_WINUSB_GET_INFO    CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa10, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINE_WINUSB_CONTROL     CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa11, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINE_WINUSB_READ_PIPE   CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa12, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINE_WINUSB_WRITE_PIPE  CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa13, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINE_WINUSB_ABORT_PIPE  CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa14, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINE_WINUSB_RESET_PIPE  CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa15, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINE_WINUSB_FLUSH_PIPE  CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa16, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINE_WINUSB_SET_ALT     CTL_CODE(FILE_DEVICE_UNKNOWN, 0xa17, METHOD_BUFFERED, FILE_ANY_ACCESS)
+
+#define WINE_WINUSB_MAX_INTERFACES 32
+
+struct wine_winusb_info
+{
+    UINT32 size;            /* total size of the valid data, including config descriptor */
+    UINT8  speed;           /* LowSpeed / FullSpeed / HighSpeed */
+    UINT8  interface_count; /* interfaces exposed through this device object */
+    UINT16 config_length;
+    UINT8  interfaces[WINE_WINUSB_MAX_INTERFACES]; /* bInterfaceNumber values, default first */
+    UINT8  device_descriptor[18];
+    UINT8  reserved[2];
+    /* followed by config_length bytes of configuration descriptor */
+};
+
+/* The pipe policies that apply to a transfer are sent along with it, so
+ * that they work the same way for synchronous and overlapped requests. */
+#define WINE_WINUSB_FLAG_ZLP              0x01  /* (writes) end with a zero length packet if needed */
+#define WINE_WINUSB_FLAG_AUTO_CLEAR_STALL 0x02  /* clear the stall when the transfer fails with one */
+#define WINE_WINUSB_FLAG_IGNORE_SHORT     0x04  /* (reads) a short packet does not complete the read */
+#define WINE_WINUSB_FLAG_ALLOW_PARTIAL    0x08  /* (reads) more data than requested is not an error */
+#define WINE_WINUSB_FLAG_AUTO_FLUSH       0x10  /* (reads) drop such data instead of keeping it for the next read */
+#define WINE_WINUSB_FLAG_RAW_IO           0x20  /* (reads) send the request to the device as it is */
+
+struct wine_winusb_transfer
+{
+    UINT8  pipe;            /* endpoint address */
+    UINT8  flags;
+    UINT16 reserved;
+    UINT32 length;
+    UINT32 timeout;         /* in milliseconds, 0 for none */
+    /* followed by length bytes of data for writes */
+};
+
+struct wine_winusb_control
+{
+    UINT8  setup[8];
+    UINT32 timeout;         /* in milliseconds, 0 for none */
+    /* followed by wLength bytes of data for host-to-device transfers */
+};
+
+struct wine_winusb_pipe
+{
+    UINT8  pipe;
+    UINT8  reserved[3];
+};
+
+struct wine_winusb_alt_setting
+{
+    UINT8  interface;       /* bInterfaceNumber */
+    UINT8  alt_setting;     /* bAlternateSetting */
+    UINT8  reserved[2];
+};
+
+/* Interface between winusb.sys and wineusb.sys.
+ *
+ * Internal ioctl; Parameters.Others.Argument1 points to a UCHAR that
+ * receives the speed the device is running at: 1 for low, 2 for full,
+ * 3 for high, 4 or more for SuperSpeed, 0 if it is not known. */
+#define IOCTL_INTERNAL_WINE_USB_GET_SPEED CTL_CODE(FILE_DEVICE_USB, 0xa80, METHOD_NEITHER, FILE_ANY_ACCESS)
+
+#endif /* __WINE_WINUSB_IOCTL_H */
